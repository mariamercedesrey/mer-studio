{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/work/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Outfit|Instrument Serif|JetBrains Mono|Instrument Sans|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Outfit, Instrument Serif, JetBrains Mono, Instrument Sans, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|label|children|variant|style2|state|disabled|href|type|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: className, style, label, children, variant, style2, state, disabled, href, type, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='style2'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> style2 must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|disabled)$/]",
        "message": "<Button> state must be one of 'default' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|type|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: className, style, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:positive|negative|alternative)$/]",
        "message": "<Icon> type must be one of 'positive' | 'negative' | 'alternative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logotypo'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|type|text1|text2|text3|key|ref|className|style|children)$/]",
        "message": "<Logotypo> doesn't accept that prop. Declared props: className, style, type, text1, text2, text3."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logotypo'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<Logotypo> type must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MockupScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<MockupScreen> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectDetailBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|body|key|ref|className|style|children)$/]",
        "message": "<ProjectDetailBlock> doesn't accept that prop. Declared props: heading, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignatureDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|size|tone|animate|key|ref|className|style|children)$/]",
        "message": "<SignatureDot> doesn't accept that prop. Declared props: className, style, size, tone, animate."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignatureDot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|dark|muted)$/]",
        "message": "<SignatureDot> tone must be one of 'accent' | 'dark' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagComponent'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|label|text1|color|size|key|ref|className|style|children)$/]",
        "message": "<TagComponent> doesn't accept that prop. Declared props: className, style, label, text1, color, size."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],

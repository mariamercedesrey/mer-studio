---
// Figma 2230:625 AI Visibility — page. Same building blocks as /start-a-project/ (intro, dark panel, steps, ink footer) + the home's FinalCTA.
// Hidden Figma layers (form fields, choices) are ignored. One Primary per section: "check my brand" (dark method panel); the final CTA is Outline Primary + Negative.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import IntakePanel from '../../components/sections/IntakePanel.astro';
import NextSteps from '../../components/sections/NextSteps.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import SectionHeading from '../../components/primitives/SectionHeading.astro';
import FaqList from '../../components/primitives/FaqList.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import Button from '../../components/primitives/Button.astro';
import { aiVisibilitySchema } from '../../data/schema';
import { aiVisibilityFaq, faqSchema } from '../../data/faq';
import { offer } from '../../data/offer';
import { llmsSnippet } from '../../data/llms-snippet';
import llms from '../../../public/llms.txt?raw';
import { copy } from '../../i18n';

const page = copy.aiVisibility;
const { buttons } = copy;

// Snippet card: generated at build from public/llms.txt (no manual sync): title, quote, "## Services" heading and its first list.
const snippet = llmsSnippet(llms);
---
<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  schema={[aiVisibilitySchema(), faqSchema(aiVisibilityFaq, 'https://mer.studio/ai-visibility/')]}
>
  <main id="main">
    <PageIntro
      id="aiv-title"
      eyebrow={page.intro.eyebrow}
      title={page.intro.title}
      note={page.intro.note}
    />
    {offer.active && (
      <section class="offer" data-offer aria-labelledby="offer-title">
        <p class="offer__tag">{offer.tag}</p>
        <h2 id="offer-title" class="offer__title">{offer.intro}</h2>
        <div class="offer__cols">
          <div class="offer__col">
            <h3 class="offer__h">{offer.free.title}</h3>
            <ul role="list" class="offer__list offer__list--free">{offer.free.items.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="offer__col">
            <h3 class="offer__h">{offer.paid.title}</h3>
            <ul role="list" class="offer__list">{offer.paid.items.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </section>
    )}
    <IntakePanel id="method-title" eyebrow={page.method.eyebrow} title={page.method.title} lede={page.method.lede}>
      <div class="method">
        <ol class="method__list" role="list">
          {page.method.items.map((m, i) => (
            <li class="mrow" data-reveal="rise">
              <div class="mrow__head"><p class="mrow__num">{String(i + 1).padStart(2, '0')}</p><h3 class="mrow__title">{m.t}</h3></div>
              <p class="mrow__desc">{m.d}</p>
            </li>
          ))}
        </ol>
        <div class="method__submit" data-reveal="rise">
          <p class="method__note"><i class="method__status" aria-hidden="true"></i><span>{page.method.note}</span></p>
          <Button class="method__btn" href="/start-a-project/?service=ai-visibility" size="lg" onDark>{buttons.checkMyBrand}</Button>
        </div>
      </div>
    </IntakePanel>
    <NextSteps id="proof-title" eyebrow={page.proof.eyebrow} title={page.proof.title} steps={page.proof.steps}>
      <figure class="snippet" data-reveal="rise">
        <figcaption class="snippet__label">{page.proof.snippetLabel}</figcaption>
        <pre class="snippet__code"><code>{snippet}</code></pre>
      </figure>
    </NextSteps>
    <section class="aiv-faq" id="faq" aria-labelledby="aiv-faq-title">
      <SectionHeading eyebrow={page.faq.eyebrow} title={page.faq.title} id="aiv-faq-title" dot={false} />
      <FaqList items={aiVisibilityFaq} prefix="aiv-faq" />
    </section>
    <FinalCTA eyebrow={page.cta.eyebrow} title={page.cta.title} />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  :global(body) { background: var(--surface-soft); }
  main { background: var(--surface-soft); }
  main :global(.intro__title) { text-wrap: wrap; } /* Figma 2230:651 breaks after "AI," (not balanced) */

  /* Launch offer notice (src/data/offer.ts): what is free in October, what stays paid. */
  .offer { display: flex; flex-direction: column; gap: var(--sp-24); padding: var(--sp-48) var(--page-gutter); background: var(--surface-soft); }
  .offer__tag { align-self: flex-start; padding: 3px 12px; border: 1px solid var(--accent-primary); border-radius: var(--r-pill); font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; letter-spacing: 0.04em; text-transform: uppercase; }
  .offer__title { max-width: 820px; font-weight: 500; font-size: var(--fs-block-title); line-height: 1.2; letter-spacing: -0.01em; }
  .offer__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-32); max-width: 1000px; }
  .offer__col { display: flex; flex-direction: column; gap: var(--sp-12); padding-left: var(--sp-20); border-left: 1px dashed var(--divider-dashed); }
  .offer__h { font-family: var(--font-technical); font-weight: 400; font-size: var(--fs-eyebrow); line-height: 1.5; letter-spacing: 0.02em; text-transform: uppercase; }
  .offer__list { display: flex; flex-direction: column; gap: var(--sp-8); font-size: var(--fs-body); line-height: 1.45; }
  .offer__list li { position: relative; padding-left: 18px; }
  .offer__list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; border-radius: 50%; background: var(--divider-dashed); }
  .offer__list--free li::before { background: var(--accent-primary); }
  @media (max-width: 767px) { .offer__cols { grid-template-columns: minmax(0, 1fr); } }

  .aiv-faq { display: flex; flex-direction: column; gap: var(--sp-32); padding: var(--sp-64) var(--page-gutter) var(--sp-96); }

  .method { flex: 1 1 0; min-width: 0; }
  .method__list { margin: 0; }
  .mrow { display: flex; gap: var(--sp-32); padding: 44px 0; border-top: 0.6px solid var(--border-subtle); }
  .mrow__head { display: flex; flex-direction: column; gap: var(--sp-12); flex: 0 0 196px; }
  .mrow__num { font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; letter-spacing: 0.02em; color: var(--accent-primary); }
  .mrow__title { font-weight: 500; font-size: var(--fs-block-title); line-height: 1.12; letter-spacing: -0.02em; }
  .mrow__desc { flex: 1 1 0; min-width: 0; opacity: 0.62; }

  .method__submit { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-32); padding-top: var(--sp-40); }
  .method__note { display: flex; gap: var(--sp-12); align-items: flex-start; max-width: 470px; font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; letter-spacing: 0.02em; opacity: 0.72; }
  .method__status { flex: none; width: 9px; height: 9px; margin-top: 3px; border-radius: 50%; background: var(--accent-primary); }
  .method__submit :global(.method__btn) { flex: none; width: 188px; }

  /* Real, selectable text — mono 14/1.6 on ink, Figma 2230:1376. */
  .snippet { margin: 0; display: flex; flex-direction: column; gap: var(--sp-12); padding: 28px var(--sp-32); border-radius: 16px; background: var(--surface-inverse); font-family: var(--font-technical); font-size: var(--fs-meta); line-height: 1.6; }
  .snippet__label { color: rgba(255, 255, 255, 0.5); }
  .snippet__code { margin: 0; color: rgba(255, 255, 255, 0.9); white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
  .snippet__code code { font: inherit; }

  @media (max-width: 1199px) {
    .mrow { flex-direction: column; gap: var(--sp-24); }
    .mrow__head { flex: none; flex-direction: row; align-items: baseline; gap: var(--sp-16); }
  }
  @media (max-width: 767px) {
    .method__submit { flex-direction: column; align-items: stretch; }
    .method__submit :global(.method__btn) { width: 100%; }
    .snippet { padding: var(--sp-24) var(--sp-20); }
  }
</style>

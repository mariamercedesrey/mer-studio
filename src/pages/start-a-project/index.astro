---
// Figma 2084:217 Project inquiry. No home intro; fixed header (light at the top, dark bar once scrolled); footer = Figma's ink footer.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import IntakePanel from '../../components/sections/IntakePanel.astro';
import InquiryForm from '../../components/sections/InquiryForm.astro';
import NextSteps from '../../components/sections/NextSteps.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import { copy } from '../../i18n';

const page = copy.startProject;
---
<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
>
  <main id="main">
    <PageIntro
      id="inq-title"
      eyebrow={page.intro.eyebrow}
      title={page.intro.title}
      note={page.intro.note}
    />
    <IntakePanel id="brief-title" eyebrow={page.brief.eyebrow} title={page.brief.title} lede={page.brief.lede}>
      <InquiryForm />
    </IntakePanel>
    <NextSteps id="next-title" eyebrow={page.next.eyebrow} title={page.next.title} steps={page.next.steps} />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  :global(body) { background: var(--surface-soft); } /* the sticky header sits on the body: light ground behind the capsule (Figma) */
  main { background: var(--surface-soft); }
</style>

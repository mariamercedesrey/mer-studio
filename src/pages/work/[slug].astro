---
// Prerendered Project Detail pages (R2-E): one per entry in data/project-details.ts → /work/<slug>/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/work/ProjectDetail.astro';
import { projectDetails, detailBlocks } from '../../data/project-details';
import { projectSchema } from '../../data/schema';

export function getStaticPaths() {
  return Object.keys(projectDetails).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const p = projectDetails[slug as keyof typeof projectDetails];
const url = new URL(Astro.url.pathname, Astro.site).href;
---
<BaseLayout
  title={`${p.client} — ${p.title} | MER Studio`}
  description={detailBlocks(p)[0].body}
  schema={projectSchema(p, url)}
>
  <main id="main">
    <ProjectDetail project={p} headingLevel="h1" closeHref="/#work" />
  </main>
</BaseLayout>

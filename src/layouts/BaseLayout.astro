---
import '../styles/global.css';
import SiteHeader from '../components/sections/SiteHeader.astro';
// Preload the one font every screen needs first (Outfit, latin subset); the rest load on demand.
import { offer } from '../data/offer';
import { getCopy, localeOf, pathIn, pageOf, LOCALES } from '../i18n';
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  noindex?: boolean;
  schema?: object; // JSON-LD, see data/schema.ts
  header?: boolean; // fixed top bar (logo + nav); the 404 has its own
}

const locale = localeOf(Astro.url);
const { site } = getCopy(locale);
const OG_LOCALE = { en: 'en_US', es: 'es_LA' } as const;

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  image = '/og.png',
  path = Astro.url.pathname,
  noindex = false,
  schema,
  header = true,
} = Astro.props;

const canonical = new URL(path, Astro.site);
// hreflang: every indexable page that exists in both languages (src/i18n/routes.ts); x-default = English. Canonical stays per language.
const known = !noindex && pageOf(path);
const alternates = known ? LOCALES.map((l) => ({ lang: l, href: new URL(pathIn(path, l), Astro.site).href })) : [];
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {offer.active && <script is:inline define:vars={{ endsAt: offer.endsAt }}>try { if (Date.now() > Date.parse(endsAt)) document.documentElement.setAttribute('data-offer-ended', ''); } catch (e) {}</script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === 'en')!.href} />}

    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f3f3" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLink}</a>
    {header && <SiteHeader />}
    <slot />
    <script>
      // Entrance motion (CLAUDE.md §22): decode titles + [data-reveal], one shared IntersectionObserver.
      import { initReveals } from '../scripts/reveal';
      import { initDecodeTitles } from '../scripts/decode-title';
      initDecodeTitles();
      initReveals();
    </script>
  </body>
</html>

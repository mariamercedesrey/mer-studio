---
// Figma 149:5483
import WorkImage from '../WorkImage.astro';
import bg from '../../../../brand/assets/work/orchardmile-bg.png';
import phone from '../../../../brand/assets/work/orchardmile-phone.png';
---
<div class="work-media" style="background:#ebebeb">
  <div class="mo__bg"><WorkImage src={bg} width={887} class="mo__bg-img fill-pic" /></div>
  <WorkImage src={phone} width={329} class="mo__phone fill-pic" />
</div>

<style is:global>
  .mo__bg { position: absolute; right: 0; top: 1.1px; width: 886px; height: 651px; overflow: hidden; opacity: 0.7; }
  .mo__bg-img { left: 3.38%; top: 0; width: 100.06%; height: 100%; }
  .mo__phone { left: 36px; top: 24.07px; width: 328.288px; height: 617.851px; }
</style>

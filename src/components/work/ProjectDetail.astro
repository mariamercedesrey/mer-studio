---
// Figma 2033:1913 / 2099:43 … 2099:337 — immersive full-screen Project Detail. One pattern for every project:
// bar (client · credit · link · close), intro (title, meta, roles) and the project's sections, laid out from
// the Figma coordinates in data/project-details.ts. Used inside the overlay <dialog> on the home page and as
// the body of the prerendered /work/<slug> page (R2-E).
import type { ProjectDetailData, DetailItem, DetailSection } from '../../data/project-details';
import DetailImage from './DetailImage.astro';
import Button from '../primitives/Button.astro';
import DecodeTitle from '../primitives/DecodeTitle.astro';
import { getCopy, localeOf } from '../../i18n';

interface Props {
  project: ProjectDetailData;
  headingLevel?: 'h1' | 'h2';
  closeHref?: string; // standalone page: the close control is a link home
}
const { project: p, headingLevel = 'h2', closeHref } = Astro.props;
const Title = headingLevel;
const { projectDetail, a11y } = getCopy(localeOf(Astro.url));
const pct = (n: number, of: number) => `${(n / of) * 100}%`;
---
<article class="pd" aria-labelledby={`pd-title-${p.id}`}>
  <header class="pd__bar">
    <p class="pd__client">{p.client}<span class="pd__credit">{p.credit}</span></p>
    <div class="pd__actions">
      {p.link && (
        <Button class="pd__link" href={p.link.href} variant="outline-secondary" target="_blank" rel="noopener">
          <span class="pd__link-label">{p.link.label}</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 3H21V9M10 14L21 3M18 13V19C18 19.53 17.79 20.04 17.41 20.41C17.04 20.79 16.53 21 16 21H5C4.47 21 3.96 20.79 3.59 20.41C3.21 20.04 3 19.53 3 19V8C3 7.47 3.21 6.96 3.59 6.59C3.96 6.21 4.47 6 5 6H11" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="visually-hidden">{a11y.opensInNewTab}</span>
        </Button>
      )}
      {closeHref ? (
        <a class="pd__close" href={closeHref} aria-label={projectDetail.close}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      ) : (
        <button class="pd__close" type="button" aria-label={projectDetail.close} data-project-close autofocus>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      )}
    </div>
  </header>

  <div class="pd__intro">
    <DecodeTitle as={Title} id={`pd-title-${p.id}`} class="pd__title" text={p.title} />
    <p class="pd__meta">{p.meta}</p>
    {p.note && <p class="pd__meta">{p.note}</p>}
    <ul role="list" class="pd__roles">{p.roles.map((r) => <li>{r}</li>)}</ul>
  </div>

  <div class="pd__body">
    {p.sections.map((s: DetailSection) => s.kind === 'flow' ? (
      <div class="pd-flow" style={`--cw:${s.cw ?? 1312};--ai:${{ start: 'flex-start', center: 'center', end: 'flex-end' }[s.align ?? 'start']}`}>
        {s.cols.map((c) => (
          <div class="pd-col" style={`--w:${c.w};--j:${{ start: 'flex-start', center: 'center', end: 'flex-end' }[c.justify ?? 'start']}`}>
            {c.items.map((i: DetailItem) => i.t === 'text' ? (
              <section class:list={['pd__block', i.panel && 'pd__block--panel']} data-reveal="rise">
                <h3 class="pd__block-title">{i.heading}</h3>
                <p class="pd__block-body">{i.body}</p>
              </section>
            ) : (
              <DetailImage src={i.src} width={i.w} alt={i.alt} desc={i.desc} style={`--iw:${pct(i.w, c.w)}`} />
            ))}
          </div>
        ))}
      </div>
    ) : (
      <div class="pd-stage" style={`--sw:${s.w};aspect-ratio:${s.w} / ${s.h}`}>
        {s.items.map((i) => {
          const pos = `z-index:${i.back ? 0 : 1};left:${pct(i.x, s.w)};top:${pct(i.y, s.h)};width:${pct(i.t === 'img' ? i.w : (i.tw ?? 470), s.w)}`;
          return i.t === 'text' ? (
            <section class="pd-stage__item pd__block" style={pos} data-reveal="rise">
              <h3 class="pd__block-title">{i.heading}</h3>
              <p class="pd__block-body">{i.body}</p>
            </section>
          ) : (
            <DetailImage src={i.src} width={i.w} alt={i.alt} desc={i.desc} style={pos} />
          );
        })}
      </div>
    ))}
  </div>
</article>

<style is:global>
  .pd {
    min-height: 100%;
    background: var(--surface-base); /* Figma modal frames are white */
    color: var(--text-primary);
    padding: 0 var(--pd-pad, 64px) 95px;
    overflow-x: clip; /* Agente Mamá's phone bleeds past the frame edge, as in Figma */
    --pd-pad: 64px;
    --fs-pd-block: clamp(32px, 3.125vw, 45px); /* proposed token: Figma block heading 45/54 */
  }
  .pd__bar {
    position: sticky; top: 0; z-index: 3;
    display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-24);
    padding: 48px 0 32px;
    background: var(--surface-base);
    border-bottom: 0.5px solid rgb(141, 141, 141);
  }
  /* Standalone /work/<slug>/ page: the fixed site bar already sticks, so the project bar scrolls with the page (in the overlay it stays sticky). */
  main > .pd .pd__bar { position: static; }
  .pd__client {
    display: flex; align-items: center; gap: var(--sp-12);
    min-height: 58px; font-size: clamp(32px, 3.333vw, 48px); line-height: 1.2; letter-spacing: 0;
  }
  .pd__credit {
    font-family: var(--font-technical); font-size: var(--fs-meta); line-height: 34px;
    letter-spacing: 0.02em; text-transform: uppercase;
  }
  .pd__actions { display: flex; align-items: flex-start; gap: var(--sp-12); flex-shrink: 0; }
  .pd__close {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; margin: -10px -10px 0 0; padding: 0;
    border: 0; background: none; color: var(--text-primary); cursor: pointer;
    border-radius: var(--r-pill);
    transition: background-color var(--dur-fast) var(--ease-precise);
  }
  .pd__close:hover { background: var(--fills-primary); }

  .pd__intro { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--sp-4); padding-top: 42px; }
  .pd__title { font-weight: 200; font-size: clamp(36px, 4.306vw, 62px); line-height: 1.2; }
  .pd__meta {
    font-family: var(--font-technical); font-size: var(--fs-meta); letter-spacing: 0.02em;
    text-transform: uppercase; min-height: 27px; display: flex; align-items: center;
  }
  .pd__roles { display: flex; flex-wrap: wrap; gap: var(--sp-4); }
  .pd__roles li {
    padding: 7px 9px; background: var(--surface-raised-dark); color: var(--text-inverse);
    font-size: var(--fs-nav); line-height: 1; letter-spacing: 0.02em; text-transform: uppercase; white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-precise), color var(--dur-fast) var(--ease-precise);
  }
  .pd__roles li:hover, .pd__roles li:focus-visible { background: var(--accent-primary-dark); color: var(--text-primary); }
  @media (prefers-reduced-motion: reduce) { .pd__roles li { transition: none; } }

  .pd__body { display: flex; flex-direction: column; gap: var(--sp-48); padding-top: 42px; }

  /* Text blocks: Figma "Title" 45/54 + body 18 */
  .pd__block { display: flex; flex-direction: column; gap: var(--sp-12); min-width: 0; }
  .pd__block-title { font-weight: 400; font-size: var(--fs-pd-block); line-height: 1.2; letter-spacing: -0.02em; }
  .pd__block-body { font-size: var(--fs-body-lg); line-height: normal; }
  .pd__block--panel { background: var(--surface-canvas); padding: clamp(24px, 5vw, 66px); }

  /* Images: display width = Figma width / column width */
  .pd-img { width: var(--iw, 100%); max-width: 100%; }
  .pd-img picture, .pd-img img { display: block; width: 100%; height: auto; }

  /* flow — columns side by side; a column is w/cw of the frame (Figma), the rest is space-between */
  .pd-flow { display: flex; justify-content: space-between; align-items: var(--ai); gap: var(--sp-24); }
  .pd-col { flex: 0 1 calc(var(--w) / var(--cw) * 100%); min-width: 0; display: flex; flex-direction: column; justify-content: var(--j); gap: var(--sp-32); }

  /* stage — free composition from Figma x/y/w; everything (text too) scales with the frame */
  .pd-stage { position: relative; container-type: inline-size; }
  .pd-stage__item, .pd-stage > .pd-img { position: absolute; }
  .pd-stage .pd__block { gap: 1.1cqw; }
  .pd-stage .pd__block-title { font-size: 3.43cqw; }
  .pd-stage .pd__block-body { font-size: 1.372cqw; }

  /* Tablet + mobile: everything stacks in reading order; images go full width. */
  @media (max-width: 1199px) {
    .pd { --pd-pad: var(--page-gutter); padding: 0 var(--page-gutter) var(--sp-80); }
    .pd__bar { padding: 20px 0; }
    .pd__intro { padding-top: var(--sp-32); }
    .pd__body { padding-top: var(--sp-48); gap: var(--sp-40); }
    .pd-flow { flex-direction: column; align-items: stretch; gap: var(--sp-40); }
    .pd-col { flex: none; gap: var(--sp-24); max-width: 720px; }
    .pd-col:has(.pd-img:only-child), .pd-col:has(.pd-img) { max-width: none; }
    .pd-col .pd__block { max-width: 720px; }
    .pd-img { width: 100%; }
    .pd-stage { aspect-ratio: auto !important; container-type: normal; display: flex; flex-direction: column; gap: var(--sp-24); }
    .pd-stage__item, .pd-stage > .pd-img { position: static; width: 100% !important; left: auto !important; top: auto !important; }
    .pd-stage .pd__block { gap: var(--sp-12); max-width: 720px; }
    .pd-stage .pd__block-title { font-size: var(--fs-pd-block); }
    .pd-stage .pd__block-body { font-size: var(--fs-body-lg); }
    .pd-stage > .pd-img[style*="width:6"] { max-width: 720px; }
  }
  @media (max-width: 767px) {
    .pd { padding-bottom: var(--sp-64); }
    /* Bar in three rows: 1 external link (left, truncates) + close (right) · 2 title (client) · 3 meta (credit), each full width. */
    .pd__bar { display: flex; flex-direction: column-reverse; align-items: stretch; justify-content: flex-start; gap: var(--sp-12); }
    .pd__actions { align-items: center; justify-content: space-between; gap: var(--sp-12); flex-shrink: 1; min-width: 0; width: 100%; }
    .pd__actions .pd__link { flex: 0 1 auto; min-width: 0; min-height: var(--btn-h-sm); padding: 0 var(--sp-16); font-size: var(--fs-meta); line-height: 20px; }
    .pd__actions .pd__link .pd__link-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pd__actions .pd__link svg { flex: none; }
    .pd__close { flex: none; margin: 0 -10px 0 auto; }
    .pd__client { flex-direction: column; align-items: flex-start; gap: var(--sp-4); font-size: 28px; min-height: 0; }
    .pd__credit { line-height: 1.4; }
    .pd__block-body { font-size: var(--fs-body); line-height: 1.5; }
    .pd-stage .pd__block-body { font-size: var(--fs-body); }
  }
</style>

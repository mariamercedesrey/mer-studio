---
// Figma 2033:1913 — immersive full-screen Project Detail. Reusable across projects: copy comes from
// project-details.ts, the gallery from a per-project slot. Used inside the overlay <dialog> on the
// home page and as the body of the prerendered /work/<slug> page (R2-E).
import type { ProjectDetailData } from '../../data/project-details';

interface Props {
  project: ProjectDetailData;
  headingLevel?: 'h1' | 'h2';
  closeHref?: string; // standalone page: the close control is a link home
}
const { project: p, headingLevel = 'h2', closeHref } = Astro.props;
const Title = headingLevel;
---
<article class="pd" aria-labelledby={`pd-title-${p.id}`}>
  <header class="pd__bar">
    <p class="pd__client">{p.client}</p>
    <div class="pd__actions">
      <a class="pd__link" href={p.link.href} target="_blank" rel="noopener">
        {p.link.label}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 3H21V9M10 14L21 3M18 13V19C18 19.53 17.79 20.04 17.41 20.41C17.04 20.79 16.53 21 16 21H5C4.47 21 3.96 20.79 3.59 20.41C3.21 20.04 3 19.53 3 19V8C3 7.47 3.21 6.96 3.59 6.59C3.96 6.21 4.47 6 5 6H11" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
      {closeHref ? (
        <a class="pd__close" href={closeHref} aria-label="Close project">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      ) : (
        <button class="pd__close" type="button" aria-label="Close project" data-project-close autofocus>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      )}
    </div>
  </header>

  <div class="pd__intro">
    <Title id={`pd-title-${p.id}`} class="pd__title">{p.title}</Title>
    <p class="pd__meta">{p.meta}</p>
    <ul role="list" class="pd__roles">{p.roles.map((r) => <li>{r}</li>)}</ul>
  </div>

  <div class="pd__body">
    <div class="pd__row">
      <div class="pd__text">
        {p.blocks.map((b) => (
          <section class="pd__block">
            <h3 class="pd__block-title">{b.heading}</h3>
            <p class="pd__block-body">{b.body}</p>
          </section>
        ))}
      </div>
      <div class="pd__hero"><slot name="hero" /></div>
    </div>
    <div class="pd__gallery"><slot name="gallery" /></div>
  </div>
</article>

<style is:global>
  .pd {
    --pd-pad: var(--page-gutter);
    min-height: 100%;
    background: var(--surface-soft);
    color: var(--text-primary);
    padding-bottom: 95px;
  }
  .pd__bar {
    position: sticky; top: 0; z-index: 2;
    display: flex; align-items: center; justify-content: space-between; gap: var(--sp-24);
    padding: 35px 0 36px 28px;
    margin: 0 16.5px 0 20px;
    background: var(--surface-soft);
    border-bottom: 0.5px solid rgb(141, 141, 141);
  }
  .pd__client { font-size: clamp(32px, 3.333vw, 48px); line-height: 1.2; }
  .pd__actions { display: flex; align-items: flex-start; gap: var(--sp-12); }
  .pd__link {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    height: 48px; padding: 0 26px;
    border: 1px solid var(--text-primary); border-radius: 55px;
    font-weight: 500; font-size: var(--fs-body); letter-spacing: 0.03em; text-transform: uppercase;
    text-decoration: none; white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-precise);
  }
  .pd__link:hover { background: var(--fills-primary); }
  .pd__close {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; margin: -10px -10px 0 0; padding: 0;
    border: 0; background: none; color: var(--text-primary); cursor: pointer;
    border-radius: var(--r-pill);
    transition: background-color var(--dur-fast) var(--ease-precise);
  }
  .pd__close:hover { background: var(--fills-primary); }

  .pd__intro { display: flex; flex-direction: column; gap: var(--sp-4); padding: 47px var(--pd-pad) 0; }
  .pd__title { font-weight: 200; font-size: clamp(36px, 4.306vw, 62px); line-height: 1.2; }
  .pd__meta {
    font-family: var(--font-technical); font-size: var(--fs-meta); letter-spacing: 0.02em;
    text-transform: uppercase; min-height: 27px; display: flex; align-items: center;
  }
  .pd__roles { display: flex; flex-wrap: wrap; gap: var(--sp-4); }
  .pd__roles li {
    padding: 7px 9px; background: var(--surface-raised-dark); color: var(--text-inverse);
    font-size: var(--fs-nav); line-height: 1; letter-spacing: 0.02em; text-transform: uppercase; white-space: nowrap;
  }

  .pd__body { display: flex; flex-direction: column; gap: var(--sp-64); padding: 72px 48px 0 43px; }
  .pd__row { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--sp-48); }
  .pd__text { display: flex; flex-direction: column; gap: 29px; width: 561px; flex-shrink: 0; }
  .pd__block { display: flex; flex-direction: column; gap: var(--sp-12); }
  .pd__block-title { font-weight: 500; font-size: 28px; line-height: normal; }
  .pd__block-body { font-size: var(--fs-body-lg); line-height: normal; }
  .pd__hero { width: 725px; max-width: 100%; aspect-ratio: 725 / 688; flex-shrink: 1; }
  .pd__hero img { width: 100%; height: 100%; object-fit: cover; }
  .pd__gallery { display: flex; align-items: flex-start; gap: var(--sp-24); }

  /* Tablet + mobile: text above the hero image; the gallery keeps its Figma sizes and
     scrolls sideways (snap) instead of being squeezed. */
  @media (max-width: 1199px) {
    .pd__bar { margin: 0 var(--page-gutter); padding: 20px 0 20px; }
    .pd__intro { padding-top: var(--sp-32); }
    .pd__body { padding: var(--sp-48) var(--page-gutter) 0; gap: var(--sp-48); }
    .pd__row { flex-direction: column; gap: var(--sp-40); }
    .pd__text { width: 100%; max-width: 720px; }
    .pd__hero { width: 100%; max-width: 725px; }
    .pd__gallery {
      overflow-x: auto;
      margin: 0 calc(-1 * var(--page-gutter));
      padding: 0 var(--page-gutter) var(--sp-16);
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-gutter);
      scrollbar-width: thin;
    }
    .pd__gallery > * { scroll-snap-align: start; }
  }
  @media (max-width: 767px) {
    .pd { padding-bottom: var(--sp-64); }
    .pd__client { font-size: 28px; }
    .pd__link { height: 44px; padding: 0 16px; font-size: var(--fs-meta); }
    .pd__actions { align-items: center; gap: var(--sp-4); }
    .pd__close { margin: 0 -10px 0 0; }
    .pd__block-title { font-size: 22px; }
    .pd__block-body { font-size: var(--fs-body); line-height: 1.5; }
  }
</style>

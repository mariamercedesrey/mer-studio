---
// Project Detail imagery: AVIF/WebP at 1× and 2× of the Figma display width. `src` is "<slug>/<name>",
// resolved against src/assets/work-detail (WebP masters made by scripts/optimize-detail-images.mjs).
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: string;
  width: number; // Figma display width in px at 1440
  alt: string;
  desc?: string; // copy baked into the image, exposed as real text
  style?: string;
}
const { src, width, alt, desc, style } = Astro.props;

const files = import.meta.glob<ImageMetadata>('../../assets/work-detail/**/*.webp', { eager: true, import: 'default' });
const meta = files[`../../assets/work-detail/${src}.webp`];
if (!meta) throw new Error(`Project Detail image not found: ${src}`);

const w1 = Math.min(Math.round(width), meta.width);
const w2 = Math.min(Math.round(width * 2), meta.width);
const widths = [...new Set([w1, w2])];
const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: meta, widths, format })),
);
const fallback = await getImage({ src: meta, width: w2, format: 'webp' });
const sizes = `(max-width: 1199px) 100vw, ${Math.round(width)}px`;
---
<figure class="pd-img" style={style}>
  <picture>
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
    <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
    <img src={fallback.src} alt={alt} width={meta.width} height={meta.height} loading="lazy" decoding="async" />
  </picture>
  {desc && <figcaption class="visually-hidden">{desc}</figcaption>}
</figure>

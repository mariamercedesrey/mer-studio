---
// Figma 149:5105 › 149:5107 — logo + tagline + nav capsule. "EN" chip removed (R2-F).
// Mobile (≤767, JS on): classic hamburger opening a full-screen menu (Mer, review round 10).
// Native <dialog>: focus containment, Esc and inert page for free. Without JS the capsule stays.
// Sticky on every page, under the home intro curtain (z-index 200) and any modal <dialog> (top layer). Two states:
// top of the home = exactly main's header (no bar); [data-scrolled] (hero "book a call" out of the viewport, and always on
// /work/<slug>/) = a 51 px dark bar, negative logo, white links. The in-flow height never changes (--header-h): the bar is
// a pseudo-element fading in, the row slides up, everything else is colour/opacity — CLS 0. On /work/<slug>/ the in-page
// anchors point back to the home.
import { EMAIL, WHATSAPP } from '../../data/contact';
const nav = [
  { label: 'selected work', href: '#work' },
  { label: 'Services', href: '#services' },
  { label: 'AI Visibility', href: '#ai-visibility' },
  { label: 'About us', href: '#about' },
];
const home = Astro.url.pathname === '/';
// Light at the top, then scrolled once [data-nav-sentinel] leaves the viewport: the home and /start-a-project/. Everywhere else (/work/<slug>/) the bar is always on.
const lightAtTop = home || Astro.url.pathname.startsWith('/start-a-project');
const link = (href: string) => (home ? href : `/${href}`);
---
<header class="site-header" data-site-header data-scrolled={lightAtTop ? undefined : ''}>
  <div class="site-header__row">
    <div class="site-header__brand">
      <a class="site-header__logo" href="/" aria-label="MER Studio, home">
        <img class="site-header__logo-pos" src="/logo.svg" width="182" height="29" alt="" />
        <img class="site-header__logo-neg" src="/logo-negative.svg" width="150" height="24" alt="" />
      </a>
      <p class="site-header__tagline">Design and build, end to end</p>
    </div>
    <nav class="site-nav" aria-label="Primary">
      <ul role="list" class="site-nav__list">
        {nav.map((item) => <li><a href={link(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <button class="site-header__toggle" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6H21M3 12H21M3 18H21" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu" data-menu>
  <div class="mobile-menu__bar">
    <a class="mobile-menu__logo" href="/" aria-label="MER Studio, home">
      <img src="/logo-negative.svg" width="150" height="24" alt="" />
    </a>
    <button class="mobile-menu__close" type="button" data-menu-close autofocus>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="visually-hidden">Close menu</span>
    </button>
  </div>
  <nav aria-label="Primary">
    <ul role="list" class="mobile-menu__list">
      {nav.map((item) => <li><a href={link(item.href)}>{item.label}</a></li>)}
    </ul>
  </nav>
  <address class="mobile-menu__contact">
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <a href={WHATSAPP.href} target="_blank" rel="noopener"><span class="visually-hidden">WhatsApp </span>{WHATSAPP.label}<span class="visually-hidden"> (opens in a new tab)</span></a>
  </address>
</dialog>

<script>
  // Scrolled state on the home and /start-a-project/: the sentinel (hero "book a call" button / the h1 block) leaving through the top of the viewport.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const sentinel = document.querySelector<HTMLElement>('[data-nav-sentinel]');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => header.toggleAttribute('data-scrolled', !e.isIntersecting && e.boundingClientRect.bottom <= 0)).observe(sentinel);
  }

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (menu && toggle) {
    toggle.addEventListener('click', () => menu.showModal());
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    // In-page links: close first, then let the anchor scroll the page.
    menu.querySelectorAll<HTMLAnchorElement>('nav a').forEach((a) => a.addEventListener('click', () => menu.close()));
    menu.addEventListener('close', () => toggle.focus({ preventScroll: true }));
    // Leaving the mobile layout with the menu open (rotation, resize) closes it.
    matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) menu.close(); });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50; /* above page content, below the intro curtain (200); modal <dialog>s live in the top layer */
    height: var(--header-h); /* constant in both states: nothing below it ever moves */
  }
  /* Scrolled bar (Mer): 51 px, #141414ab, 0.5 px rule. Fades in; the header itself stays transparent at the top. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--header-bar-h);
    background: var(--surface-nav-scrolled);
    border-bottom: 0.5px solid var(--border-nav-scrolled);
    -webkit-backdrop-filter: blur(var(--blur-nav-scrolled)); /* only ever visible with the bar (opacity 1) */
    backdrop-filter: blur(var(--blur-nav-scrolled));
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-nav) var(--ease-enter);
  }
  /* Light state (Figma 2126:243): full-width 50 % white ground so the logo never merges with the hero type. Fades out as the dark bar fades in. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: 0 0 calc(var(--sp-8) * -1); /* a little air under the logo; overhangs the header, no layout shift */
    background: var(--surface-nav-light);
    -webkit-backdrop-filter: blur(var(--blur-nav));
    backdrop-filter: blur(var(--blur-nav));
    pointer-events: none;
    transition: opacity var(--dur-nav) var(--ease-enter), visibility 0s linear;
  }
  .site-header__row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-24);
    height: 100%;
    padding: var(--header-pad-top) var(--page-gutter) 0;
    transition: transform var(--dur-nav) var(--ease-enter);
  }
  .site-header__brand { display: flex; align-items: flex-end; gap: 14px; }
  .site-header__logo { position: relative; display: inline-flex; }
  .site-header__logo-pos { width: 182px; height: auto; transition: opacity var(--dur-nav) var(--ease-enter); }
  .site-header__logo-neg { position: absolute; left: 0; top: 50%; width: 150px; height: auto; opacity: 0; transform: translateY(-50%); transition: opacity var(--dur-nav) var(--ease-enter); }
  .site-header__tagline {
    font-family: var(--font-technical);
    font-size: var(--fs-caption);
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-tagline);
    transition: color var(--dur-nav) var(--ease-enter), transform var(--dur-nav) var(--ease-enter);
  }
  .site-nav {
    position: relative;
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 11px;
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 19.262px;
    padding: 0 12.316px;
    margin: 0;
  }
  .site-nav a {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-caption);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-nav) var(--ease-enter);
  }
  /* Extend the hit area to 44px without changing the drawn capsule. */
  .site-nav a::after { content: ''; position: absolute; inset: -16px -9px; }
  /* Figma 149:5117, with labels in text-secondary instead of muted for 4.5:1 (Mer, PR #7); hover/focus darkens to ink and the 5px signature dot appears
     right after the label (2083:43), sitting on the x-height like a full stop. */
  .site-nav a::before {
    content: '';
    position: absolute;
    left: calc(100% + 5px); /* a full stop's breath away from the label, as in Figma */
    top: 6px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-bright);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity var(--dur-fast) var(--ease-precise), transform var(--dur-fast) var(--ease-bounce);
  }
  .site-nav a:hover, .site-nav a:focus-visible { color: var(--text-primary); }
  .site-nav a:hover::before, .site-nav a:focus-visible::before { opacity: 1; transform: none; }

  /* ── Scrolled state (needs JS: without it the header keeps its top look on a soft ground) ── */
  :global(html.js) .site-header[data-scrolled]::before { opacity: 1; }
  :global(html.js) .site-header[data-scrolled]::after { opacity: 0; visibility: hidden; -webkit-backdrop-filter: none; backdrop-filter: none; transition: opacity var(--dur-nav) var(--ease-enter), visibility 0s linear var(--dur-nav); }
  /* The row is centred on y 44 (28 + 32/2; 20 + 48/2 on mobile); the bar's centre is 25.5 → −18.5 px. */
  :global(html.js) .site-header[data-scrolled] .site-header__row { transform: translateY(calc(var(--header-bar-h) / 2 - var(--header-pad-top) - var(--header-content-h) / 2)); }
  :global(html.js) .site-header[data-scrolled] .site-header__logo-pos { opacity: 0; }
  :global(html.js) .site-header[data-scrolled] .site-header__logo-neg { opacity: 1; }
  :global(html.js) .site-header[data-scrolled] .site-header__tagline { color: var(--fg-on-ink); transform: translateX(-32px); /* 182 → 150 px logo */ }
  :global(html.js) .site-header[data-scrolled] .site-nav a,
  :global(html.js) .site-header[data-scrolled] .site-nav a:hover,
  :global(html.js) .site-header[data-scrolled] .site-nav a:focus-visible { color: var(--text-inverse); }
  :global(html.js) .site-header[data-scrolled] .site-header__toggle { color: var(--text-inverse); }
  :global(html:not(.js)) .site-header { background: var(--surface-soft); border-bottom: 0.5px solid var(--border-subtle); }

  @media (max-width: 1199px) {
    .site-header__tagline { display: none; }
  }
  .site-header__toggle { display: none; }

  @media (max-width: 767px) {
    .site-header__logo-pos { width: 150px; }
    .site-nav a::after { inset: -16px -6px; }
    /* No JS: the capsule stays, in a static column above the hero. */
    :global(html:not(.js)) .site-header { position: static; height: auto; }
    :global(html:not(.js)) .site-header__row { flex-direction: column; align-items: flex-start; gap: var(--sp-20); padding-bottom: var(--sp-12); }
    .site-nav { max-width: 100%; overflow-x: auto; scrollbar-width: none; }
    .site-nav__list { gap: 16px; padding: 0 6px; }
    /* JS on: logo + hamburger in one row; the capsule moves into the full-screen menu. */
    :global(.js) .site-nav { display: none; }
    :global(.js) .site-header__toggle {
      display: inline-flex; align-items: center; justify-content: center;
      width: var(--hit-min); height: var(--hit-min); margin-right: -12px; padding: 0;
      border: 0; background: none; color: var(--text-primary); cursor: pointer;
      border-radius: var(--r-pill);
      transition: color var(--dur-nav) var(--ease-enter);
    }
  }

  /* Full-screen menu — on ink, like the Contact block. */
  .mobile-menu {
    position: fixed; inset: 0;
    width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 20px var(--page-gutter) var(--sp-40);
    border: 0;
    display: none;
    flex-direction: column;
    gap: var(--sp-64);
    background: var(--surface-inverse);
    color: var(--text-inverse);
    overflow-y: auto; overscroll-behavior: contain;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-precise), display var(--dur-base) allow-discrete, overlay var(--dur-base) allow-discrete;
  }
  .mobile-menu[open] { display: flex; opacity: 1; }
  @starting-style { .mobile-menu[open] { opacity: 0; } }
  .mobile-menu::backdrop { background: transparent; }
  :global(html:has(.mobile-menu[open])) { overflow: hidden; }

  .mobile-menu__bar { display: flex; align-items: center; justify-content: space-between; }
  .mobile-menu__logo { display: inline-flex; }
  .mobile-menu__logo img { width: 150px; height: auto; }
  .mobile-menu__close {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--hit-min); height: var(--hit-min); margin-right: -12px; padding: 0;
    border: 0; background: none; color: var(--text-inverse); cursor: pointer;
    border-radius: var(--r-pill);
  }
  .mobile-menu__list { display: flex; flex-direction: column; gap: var(--sp-24); margin: 0; }
  .mobile-menu__list a {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-work-title);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-precise);
  }
  .mobile-menu__contact { display: flex; flex-direction: column; gap: var(--sp-12); margin-top: auto; font-style: normal; }
  .mobile-menu__contact a {
    font-size: var(--fs-body);
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
  }
  .mobile-menu__list a:hover, .mobile-menu__contact a:hover { color: var(--accent-primary); }

  @media (prefers-reduced-motion: reduce) { .mobile-menu { transition: none; } }
</style>

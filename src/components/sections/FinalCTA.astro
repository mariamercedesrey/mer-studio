---
// Figma 149:6074 Final CTA.
import Button from '../primitives/Button.astro';
import SignatureDot from '../primitives/SignatureDot.astro';
import DecodeTitle from '../primitives/DecodeTitle.astro';
import { BOOKING_URL } from '../../data/contact';
---
<section class="cta" aria-labelledby="cta-title">
  <div class="cta__copy">
    <p class="cta__eyebrow">That's all for now.</p>
    <DecodeTitle as="h2" id="cta-title" class="cta__title" text={"Got a project in mind?\nLet’s talk"}><SignatureDot class="cta__dot" /></DecodeTitle>
  </div>
  <div class="cta__action" data-reveal="rise">
    <Button href={BOOKING_URL} variant="outline-primary" target="_blank" rel="noopener">let's talk<span class="visually-hidden"> (book a 20-minute call, opens in a new tab)</span></Button>
    <Button href="/start-a-project/" variant="negative">start a project</Button>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    gap: 45px;
    padding: 66px var(--page-gutter);
    background: var(--surface-inverse);
    color: var(--text-inverse);
    border-top: 0.6px solid var(--border-default);
  }
  .cta__copy { display: flex; flex-direction: column; gap: 4px; min-height: 214px; }
  .cta__eyebrow { font-family: var(--font-technical); font-size: var(--fs-eyebrow); line-height: 1.5; letter-spacing: 0.02em; }
  /* :global — the h2 is rendered by DecodeTitle, so it never carries this component's scope attribute. */
  .cta :global(.cta__title) {
    font-weight: 400;
    font-size: clamp(44px, 5.556vw, 80px);
    line-height: 1.16;
    letter-spacing: -0.02em;
  }
  .cta :global(.cta__title .cta__dot) { margin-left: 0.25em; vertical-align: -0.04em; }
  .cta__action { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }

  @media (max-width: 767px) {
    .cta { padding-top: var(--sp-64); padding-bottom: var(--sp-64); gap: var(--sp-40); }
    .cta__copy { min-height: 0; }
    .cta__action { justify-content: flex-start; }
  }
</style>

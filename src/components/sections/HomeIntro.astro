---
// Home intro — Figma 2132:1353 (loading01) / 2132:2468 (loading02). Session-only overlay on "/": dark ground → the
// logo (the nav's own SVG, /logo-negative.svg) fades in → ~1 s pause → each tagline line "ghosts" in (blur + opacity →
// sharp) → 1 s hold → the curtain (rounded bottom corners, 24 px) lifts slowly to reveal the home and its top bar.
// The whole timeline is CSS (it completes even if JS fails); scripts/home-intro.ts lifts the curtain on the first scroll gesture.
// While html[data-intro] is set the page does not scroll (exception in CLAUDE.md §22).
// The gate lives in the inline <head> script in pages/index.astro (sets html[data-intro]).
import { copy } from '../../i18n';
const { home, site } = copy;
---
<div class="home-intro" aria-hidden="true" data-home-intro>
  <div class="home-intro__stack">
    <img class="home-intro__logo" src="/logo-negative.svg" width="306" height="48" alt={site.logoAlt} />
    <p class="home-intro__quote">
      <span class="home-intro__line home-intro__line--1">{home.intro.line1}</span>
      <span class="home-intro__line home-intro__line--2">{home.intro.line2}</span>
    </p>
  </div>
</div>

<script>
  import { initHomeIntro } from '../../scripts/home-intro';
  initHomeIntro();
</script>

<style is:global>
  .home-intro { display: none; }
  html[data-intro] .home-intro {
    /* Timeline (~5.2 s): logo 0–700 · pause 1 s · line 1 1700–2400 · line 2 2400–3100 · 1 s hold, everything visible ·
       curtain 4100–5200 ms (--dur-curtain, --ease-in-out). The first scroll gesture lifts the curtain early (scripts/home-intro.ts). */
    --intro-logo: 700ms;
    --intro-ghost: 700ms;
    --intro-line-1: 1700ms;
    --intro-line-2: 2400ms;
    --intro-lift-delay: 4100ms;
    position: fixed;
    inset: 0 0 calc(-1 * var(--r-24)); /* 24 px taller than the viewport: the rounded corners stay off-screen until the curtain rises */
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-32) var(--page-gutter) calc(var(--sp-32) + var(--r-24));
    background: var(--surface-inverse); --focus-ring: var(--focus-ring-on-dark);
    color: var(--text-inverse);
    border-radius: 0 0 var(--r-24) var(--r-24); /* Figma 2132:2256 */
    animation: home-intro-lift var(--dur-curtain) var(--ease-in-out) var(--intro-lift-delay) both;
    will-change: transform;
  }
  /* Figma 2132:2469: logo 270.521 px wide, 28.703 px above the quote, at 58.582 px of "em" (1440). */
  .home-intro__stack { display: flex; flex-direction: column; align-items: center; gap: 0.49em; font-size: clamp(36px, 4.07vw, 58.582px); }
  .home-intro__logo { width: 4.618em; height: auto; animation: home-intro-fade var(--intro-logo) var(--ease-enter) both; }

  /* Figma 2132:2255 — Instrument Serif Italic 35.878 px / 1.01, centred, 766 px wide. */
  .home-intro__quote {
    display: flex;
    flex-direction: column;
    max-width: 21.35em;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 35.878px);
    line-height: 1.01;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
  }
  .home-intro__line { animation: home-intro-ghost var(--intro-ghost) var(--ease-enter) both; }
  .home-intro__line--1 { animation-delay: var(--intro-line-1); }
  .home-intro__line--2 { animation-delay: var(--intro-line-2); }

  /* Logo: opacity. Lines: "ghost" = blur + opacity (Mer's brief). Curtain: transform; it hides itself at the end. */
  @keyframes home-intro-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes home-intro-ghost { from { opacity: 0; filter: blur(12px); } to { opacity: 1; filter: blur(0); } }
  @keyframes home-intro-lift {
    from { transform: translateY(0); visibility: visible; }
    to { transform: translateY(-100%); visibility: hidden; }
  }

  /* Scroll lock while the intro lasts. scrollbar-gutter keeps the width, so nothing shifts when it is released.
     Failsafe: if the script never runs, the lock lifts itself once the curtain is long gone. */
  @media (prefers-reduced-motion: no-preference) {
    html[data-intro] { overflow: hidden; overscroll-behavior: none; scrollbar-gutter: stable; animation: home-intro-unlock 0s 6s both; }
  }
  @keyframes home-intro-unlock { to { overflow: visible; } }

  @media (prefers-reduced-motion: reduce) {
    html[data-intro] .home-intro { display: none; }
  }
</style>

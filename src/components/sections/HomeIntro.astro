---
// Home intro — Figma 2132:1353 (loading01). Session-only overlay on "/": dark ground → logo fades in →
// the two tagline lines fade in staggered → short hold → the curtain lifts and reveals the home, which is
// already rendered underneath. Text only (no images, no extra fonts).
// The whole timeline is CSS (it completes even if JS fails); scripts/home-intro.ts only accelerates it on input.
// The gate lives in the inline <head> script in pages/index.astro (sets html[data-intro]).
---
<div class="home-intro" aria-hidden="true" data-home-intro>
  <div class="home-intro__stack">
    <p class="home-intro__logo">
      <span class="home-intro__mer">mer</span>
      <span class="home-intro__studio">studio</span>
      <span class="home-intro__tm">™</span>
      <span class="home-intro__dot"></span>
    </p>
    <p class="home-intro__quote">
      <span class="home-intro__line home-intro__line--1">“From the first decision to the last detail.</span>
      <span class="home-intro__line home-intro__line--2">Strategy, design &amp; build, end to end.”</span>
    </p>
  </div>
</div>

<script>
  import { initHomeIntro } from '../../scripts/home-intro';
  initHomeIntro();
</script>

<style is:global>
  .home-intro { display: none; }
  html[data-intro] .home-intro {
    /* Timeline (~2.5 s): logo 0–600 · line 1 400–1000 · line 2 600–1200 · hold · curtain 1700–2500 ms. */
    --intro-fade: var(--dur-slow);
    --intro-lift-delay: 1700ms;
    --intro-lift: 800ms;
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-32) var(--page-gutter);
    background: var(--surface-inverse);
    color: var(--text-inverse);
    animation: home-intro-lift var(--intro-lift) var(--ease-enter) var(--intro-lift-delay) both;
    will-change: transform;
  }
  .home-intro__stack { display: flex; flex-direction: column; align-items: center; gap: 0.8em; font-size: clamp(36px, 4.07vw, 58.582px); }

  /* Figma 2132:2249 — "mer" ExtraBold, "studio" Light offset 112.52 px, "™" and the yellow dot (offsets in em of 58.582 px). */
  .home-intro__logo {
    position: relative;
    display: inline-grid;
    place-items: start;
    font-family: var(--font-brand);
    font-size: 1em;
    line-height: normal;
    white-space: nowrap;
    text-box: trim-both cap alphabetic;
    animation: home-intro-fade var(--intro-fade) var(--ease-enter) both;
  }
  .home-intro__logo > * { grid-area: 1 / 1; }
  .home-intro__mer { margin-top: 0.0577em; font-weight: 800; letter-spacing: -0.06em; }
  .home-intro__studio { margin: 0.0577em 0 0 1.9208em; font-weight: 300; letter-spacing: -0.07em; }
  .home-intro__tm { margin-left: 6.143em; /* 252.9 px, in em of its own 0.7027em size */ font-size: 0.7027em; font-weight: 300; letter-spacing: -0.07em; }
  .home-intro__dot {
    width: 0.1546em;
    height: 0.1516em;
    margin: 0.5729em 0 0 1.7008em;
    border-radius: 50%;
    background: var(--accent-primary);
  }

  /* Figma 2132:2255 — Instrument Serif Italic 35.878 px / 1.01, centred, 766 px wide. */
  .home-intro__quote {
    display: flex;
    flex-direction: column;
    max-width: 21.35em;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 35.878px);
    line-height: 1.01;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
  }
  .home-intro__line { animation: home-intro-fade var(--intro-fade) var(--ease-enter) both; }
  .home-intro__line--1 { animation-delay: 400ms; }
  .home-intro__line--2 { animation-delay: 600ms; }

  /* Opacity and transform only; the curtain hides itself at the end, so nothing is left to catch input. */
  @keyframes home-intro-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes home-intro-lift {
    from { transform: translateY(0); visibility: visible; }
    to { transform: translateY(-100%); visibility: hidden; }
  }

  @media (prefers-reduced-motion: reduce) {
    html[data-intro] .home-intro { display: none; }
  }
</style>

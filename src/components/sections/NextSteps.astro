---
// "What happens next" (Figma 2084:217; 2230:761 on /ai-visibility/): heading + dot, three numbered steps, optional slot below (the llms.txt snippet).
import SectionHeading from '../primitives/SectionHeading.astro';
import SignatureDot from '../primitives/SignatureDot.astro';
interface Props { eyebrow: string; title: string; id: string; steps: { t: string; d: string }[] }
const { eyebrow, title, id, steps } = Astro.props;
---
<section class="next" aria-labelledby={id}>
  <div class="next__head">
    <SectionHeading eyebrow={eyebrow} title={title} id={id} dot={false} />
    <SignatureDot size={24} />
  </div>
  <ol class="next__steps" role="list">
    {steps.map((s, i) => (
      <li class="step" data-reveal="rise">
        <p class="step__num">{String(i + 1).padStart(2, '0')}</p>
        <h3 class="step__title">{s.t}</h3>
        <p class="step__desc">{s.d}</p>
      </li>
    ))}
  </ol>
  <slot />
</section>

<style>
  .next { display: flex; flex-direction: column; gap: var(--sp-32); padding: var(--sp-64) var(--page-gutter) 72px; }
  .next__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--sp-24); }
  .next__head :global(.section-heading) { gap: var(--sp-12); }
  .next__steps { display: flex; gap: var(--sp-24); margin: 0; }
  .step { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--sp-8); padding: var(--sp-20) var(--sp-24) 0 0; border-top: 0.7px solid var(--border-default); }
  .step__num { font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; letter-spacing: 0.02em; color: var(--text-secondary); margin-bottom: var(--sp-12); }
  .step__title { font-weight: 500; font-size: var(--fs-lead-sm); line-height: 1.2; }
  .step__desc { color: var(--text-secondary); }
  @media (max-width: 1199px) { .next__steps { flex-direction: column; gap: var(--sp-32); } }
</style>

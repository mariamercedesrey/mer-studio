---
// Figma 149:6015 About: heading (eyebrow, scroll-revealed title, body), profile card (enters from the left),
// four stats (numbers count up), booking button.
import Button from '../primitives/Button.astro';
import CountUp from '../primitives/CountUp.astro';
import WordReveal from '../primitives/WordReveal.astro';
import { BOOKING_URL } from '../../data/contact';
import { getImage } from 'astro:assets';
import portrait from '../../assets/mer-card.png';
import { getCopy, localeOf } from '../../i18n';
const { about, buttons, a11y } = getCopy(localeOf(Astro.url));
const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: portrait, widths: [98, 196], format })),
);
const stats = about.stats.map((s, i) => ({ ...s, count: i !== 2 })); // "1:1" (third) only fades in
---
<section id="about" class="about" aria-labelledby="about-title">
  <div class="about__copy">
    <div class="about__heading">
      <p class="about__eyebrow">{about.eyebrow}</p>
      <WordReveal as="h2" id="about-title" class="about__title" text={about.title} />
    </div>
    <p class="about__body" data-reveal="rise">{about.body}</p>
  </div>

  <div class="about__card-row">
    <figure class="about__card" data-reveal>
      <picture class="about__portrait">
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes="98px" />
        <source type="image/webp" srcset={webp.srcSet.attribute} sizes="98px" />
        <img src={webp.src} alt={about.portraitAlt} width={portrait.width} height={portrait.height} loading="lazy" decoding="async" />
      </picture>
      <div class="about__card-copy">
        <figcaption class="about__who">
          <span class="about__name">{about.name}</span>
          <span class="about__role">{about.role}</span>
        </figcaption>
        <blockquote class="about__quote">{about.quote}</blockquote>
      </div>
    </figure>
  </div>

  <dl class="about__stats">
    {stats.map((s) => (
      <div class="about__stat" data-reveal="rise">
        <dt class="about__value"><CountUp value={s.value} count={s.count} /></dt>
        <dd class="about__label">{s.label}</dd>
      </div>
    ))}
  </dl>
  <div data-reveal="rise"><Button href={BOOKING_URL} width={201} size="lg" onDark target="_blank" rel="noopener">{buttons.bookCall}<span class="visually-hidden"> {a11y.opensInNewTab}</span></Button></div>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-64);
    padding: 100px var(--page-gutter);
    background: var(--surface-inverse); --focus-ring: var(--focus-ring-on-dark);
    color: var(--text-inverse);
  }
  .about__copy { width: 100%; max-width: 1058px; align-self: flex-start; display: flex; flex-direction: column; gap: var(--sp-24); }
  .about__heading { display: flex; flex-direction: column; gap: var(--sp-24); padding-top: 3.95px; }
  .about__eyebrow { font-family: var(--font-technical); font-size: var(--fs-eyebrow); line-height: 1.5; letter-spacing: 0.02em; color: var(--fg-on-ink); }
  .about__title { font-weight: 500; font-size: clamp(34px, 3.333vw, 48px); line-height: 1.1; letter-spacing: -0.02em; }
  .about__body { font-size: var(--fs-body-xl); line-height: 1.5; }

  /* Profile card — right-aligned, 856 of 1344 (Figma 2121:163). Enters once from the left: transform + opacity only. */
  .about__card-row { width: 100%; display: flex; justify-content: flex-end; }
  .about__card {
    width: 100%; max-width: 856px; margin: 0;
    display: flex; align-items: center; gap: var(--sp-20);
    padding: var(--sp-16);
    background: var(--surface-overlay-ink);
    border-radius: var(--r-16);
    color: var(--fg-on-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .about__card {
      opacity: 0;
      transform: translateX(calc(-1 * var(--enter-shift)));
      transition: opacity var(--dur-section) var(--ease-enter), transform var(--dur-section) var(--ease-enter);
    }
    :global(.js) .about__card.is-in { opacity: 1; transform: none; }
  }
  .about__portrait { flex: none; width: 98px; aspect-ratio: 98 / 101; border: 0.275px dashed var(--fg-on-ink); border-radius: 50%; overflow: hidden; }
  .about__portrait img { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
  .about__card-copy { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--sp-16); }
  .about__who { display: flex; flex-direction: column; }
  .about__name { font-weight: 500; font-size: var(--fs-lead); line-height: 1.2; }
  .about__role { font-family: var(--font-technical); font-size: var(--fs-meta); line-height: 1.4; letter-spacing: 0.02em; }
  .about__quote { margin: 0; font-family: var(--font-editorial); font-style: italic; font-size: var(--fs-body); line-height: 1.5; }

  .about__stats { width: 100%; display: flex; margin: 0; border: 0.45px dashed var(--fg-on-ink); }
  .about__stat {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-12);
    padding: 25px var(--sp-40);
    border-left: 0.4px dashed var(--fg-on-ink);
  }
  .about__stat:first-child { border-left: 0; }
  .about__value { font-weight: 500; font-size: clamp(34px, 3.333vw, 48px); line-height: 1.1; letter-spacing: -0.02em; color: var(--accent-primary); }
  .about__label { margin: 0; font-size: var(--fs-meta); line-height: 1.5; color: var(--fg-on-ink); }

  @media (max-width: 1199px) {
    .about { padding-top: var(--sp-80); padding-bottom: var(--sp-80); gap: var(--sp-48); }
    .about__stats { display: grid; grid-template-columns: 1fr 1fr; }
    .about__stat { padding: var(--sp-24); }
    .about__stat:nth-child(even) { border-left: 0.4px dashed var(--fg-on-ink); }
    .about__stat:nth-child(odd) { border-left: 0; }
    .about__stat:nth-child(n + 3) { border-top: 0.4px dashed var(--fg-on-ink); }
  }
  @media (max-width: 767px) {
    .about__card { flex-direction: column; align-items: flex-start; }
    .about__stat { padding: var(--sp-20) var(--sp-16); gap: var(--sp-8); }
    .about__label { font-size: var(--fs-caption); }
  }
</style>

---
// Figma 2084:251 Inquiry form — Netlify Forms (name="project-inquiry"), honeypot, native validation with inline messages,
// AJAX submit with a fallback to /start-a-project/thanks/. ?service=<slug> preselects a service chip. Script at the bottom.
import Button from '../primitives/Button.astro';
const services = ['Branding', 'Website', 'Digital product', 'AI visibility', 'Design system', 'Something else'];
const timing = ['As soon as possible', 'Within 1–3 months', '3–6 months', 'Just exploring'];
---
<div class="inquiry" data-inquiry>
  <form
    class="inquiry__form"
    name="project-inquiry"
    method="POST"
    action="/start-a-project/thanks/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    aria-label="Project inquiry"
    data-inquiry-form
  >
    <input type="hidden" name="form-name" value="project-inquiry" />
    <p class="visually-hidden" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

    <section class="fsec" data-reveal="rise" aria-labelledby="fs-1">
      <div class="fsec__head"><p class="fsec__num">01</p><h3 id="fs-1" class="fsec__title">First, who are you?</h3></div>
      <div class="fsec__body">
        <div class="frow">
          <div class="field">
            <label class="field__label" for="f-name">YOUR NAME *</label>
            <input class="field__input" id="f-name" name="name" type="text" autocomplete="name" placeholder="Name and surname" required aria-describedby="f-name-err" />
            <p class="field__error" id="f-name-err" data-error hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="f-email">WORK EMAIL *</label>
            <input class="field__input" id="f-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required aria-describedby="f-email-err" />
            <p class="field__error" id="f-email-err" data-error hidden></p>
          </div>
        </div>
        <div class="frow">
          <div class="field">
            <label class="field__label" for="f-company">COMPANY / ORGANIZATION</label>
            <input class="field__input" id="f-company" name="company" type="text" autocomplete="organization" placeholder="Where do you work?" />
          </div>
          <div class="field">
            <label class="field__label" for="f-phone">PHONE / WHATSAPP</label>
            <input class="field__input" id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="Country code + number" />
          </div>
        </div>
      </div>
    </section>

    <section class="fsec" data-reveal="rise" aria-labelledby="fs-2">
      <div class="fsec__head"><p class="fsec__num">02</p><h3 id="fs-2" class="fsec__title">What can we make together?</h3></div>
      <div class="fsec__body">
        <fieldset class="chips">
          <legend class="visually-hidden">Services (choose any)</legend>
          {services.map((s) => (
            <label class="chip"><input type="checkbox" name="services" value={s} /><span class="chip__face"><i class="chip__dot" aria-hidden="true"></i>{s}</span></label>
          ))}
        </fieldset>
        <div class="field">
          <label class="field__label" for="f-message">TELL US ABOUT THE PROJECT *</label>
          <textarea class="field__input field__input--area" id="f-message" name="message" rows="3" placeholder="What are you building, changing, or trying to solve? A link is welcome, too." required aria-describedby="f-message-err"></textarea>
          <p class="field__error" id="f-message-err" data-error hidden></p>
        </div>
      </div>
    </section>

    <section class="fsec" data-reveal="rise" aria-labelledby="fs-3">
      <div class="fsec__head"><p class="fsec__num">03</p><h3 id="fs-3" class="fsec__title">Timing</h3></div>
      <div class="fsec__body">
        <fieldset class="field field--group">
          <legend class="field__label">IDEAL START</legend>
          <div class="chips">
            {timing.map((t) => (
              <label class="chip"><input type="radio" name="ideal-start" value={t} /><span class="chip__face"><i class="chip__dot" aria-hidden="true"></i>{t}</span></label>
            ))}
          </div>
        </fieldset>
      </div>
    </section>

    <div class="submit" data-reveal="rise">
      <p class="submit__note"><i class="submit__status" aria-hidden="true"></i><span>We’ll review your note and reply within 2 business days with a focused next step — usually a 20-minute introduction call.</span></p>
      <Button class="submit__btn" type="submit" size="lg" onDark data-submit>send inquiry</Button>
    </div>
    <p class="submit__msg" role="status" aria-live="polite" data-status></p>
  </form>

  <div class="inquiry__done" data-done tabindex="-1" hidden>
    <p class="inquiry__done-mark" aria-hidden="true"></p>
    <p class="inquiry__done-text">Thanks — we'll reply within 2 business days.</p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-inquiry]');
  const form = root?.querySelector<HTMLFormElement>('[data-inquiry-form]');
  if (root && form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    // Deep link: /start-a-project/?service=ai-visibility preselects that service chip (matched by slug of the chip's value).
    const wanted = new URLSearchParams(location.search).get('service')?.toLowerCase();
    if (wanted) {
      const slug = (v: string) => v.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      form.querySelectorAll<HTMLInputElement>('input[name="services"]').forEach((c) => { if (slug(c.value) === wanted) c.checked = true; });
    }
    form.noValidate = true; // JS owns the messages; without JS the browser's native validation runs

    const message = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const v = el.validity;
      if (el.name === 'name') return 'Please tell us your name.';
      if (el.name === 'email') return v.valueMissing ? 'Please add your email so we can reply.' : 'That email doesn’t look right — try you@company.com.';
      return 'Tell us a little about the project.';
    };
    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const err = form.querySelector<HTMLElement>(`#${el.id}-err`);
      const bad = !el.checkValidity();
      el.setAttribute('aria-invalid', String(bad));
      if (err) { err.hidden = !bad; err.textContent = bad ? message(el) : ''; }
      return !bad;
    };
    const required = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
    required.forEach((el) => {
      el.addEventListener('blur', () => { if (el.value) check(el); });
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') check(el); });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = required.filter((el) => !check(el));
      if (invalid.length) { status.textContent = ''; invalid[0].focus(); return; }
      btn.disabled = true;
      btn.textContent = 'sending…';
      status.textContent = '';
      try {
        // Netlify Forms: urlencoded body incl. hidden form-name; multi-select chips go as one repeated `services` field per value.
        const data = new FormData(form);
        const params = new URLSearchParams();
        data.forEach((v, k) => { if (typeof v === 'string') params.append(k, v); });
        if (!params.has('form-name')) params.set('form-name', 'project-inquiry');
        const res = await fetch(form.getAttribute('action') || '/start-a-project/thanks/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'send inquiry';
        const code = err instanceof Error && /^\d{3}$/.test(err.message) ? err.message : '';
        const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
        status.textContent = local && (code === '404' || code === '405' || code === '501')
          ? 'Forms only work on the Netlify deploy (Netlify handles the POST); this local server can’t receive them.'
          : `Something went wrong sending your note${code ? ` (error ${code})` : ''}. Try again, or write to hello@mer.studio.`;
      }
    });
  }
</script>

<style>
  .inquiry { flex: 1 1 0; min-width: 0; }
  .fsec {
    display: flex;
    gap: var(--sp-32);
    padding: 44px 0;
    border-top: 0.6px solid var(--border-subtle);
  }
  .fsec__head { display: flex; flex-direction: column; gap: var(--sp-12); flex: 0 0 196px; }
  .fsec__num { font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; letter-spacing: 0.02em; color: var(--accent-primary); }
  .fsec__title { font-weight: 500; font-size: var(--fs-block-title); line-height: 1.12; letter-spacing: -0.02em; }
  .fsec__body { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .frow { display: flex; gap: var(--sp-32); }
  .frow > .field { flex: 1 1 0; min-width: 0; }

  .field { display: flex; flex-direction: column; gap: var(--sp-12); min-width: 0; border: 0; padding: 0; margin: 0; }
  .field__label { font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; letter-spacing: 0.02em; opacity: 0.68; padding: 0; }
  legend.field__label { margin-bottom: var(--sp-12); }
  .field__input {
    width: 100%;
    height: 44px;
    padding: 0 0 14px;
    border: 0;
    border-bottom: 1px solid var(--border-subtle);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--fs-body-lg);
    line-height: 1.4;
    transition: border-color var(--dur-fast) var(--ease-precise);
  }
  .field__input::placeholder { color: inherit; opacity: 0.42; }
  .field__input:hover { border-bottom-color: var(--text-inverse); }
  .field__input:focus-visible { outline: 0; border-bottom-color: var(--accent-primary); box-shadow: 0 1px 0 0 var(--accent-primary); }
  .field__input--area { height: auto; min-height: 112px; padding-top: 4px; resize: vertical; }
  .field__input[aria-invalid='true'] { border-bottom-color: var(--accent-bright); }
  .field__error { font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; letter-spacing: 0.02em; color: var(--accent-bright); }

  .chips { display: flex; flex-wrap: wrap; gap: var(--sp-12); border: 0; padding: 0; margin: 0; min-width: 0; }
  .chip { position: relative; display: inline-flex; cursor: pointer; }
  .chip input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .chip__face {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    padding: 11px var(--sp-16);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-pill);
    background: var(--surface-charcoal);
    font-weight: 500;
    font-size: var(--fs-caption);
    line-height: 1.2;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-precise), color var(--dur-fast) var(--ease-precise), border-color var(--dur-fast) var(--ease-precise);
  }
  .chip__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-inverse); opacity: 0.5; }
  .chip:hover .chip__face { border-color: var(--text-inverse); }
  .chip input:checked + .chip__face { background: var(--accent-primary); border-color: var(--accent-primary); color: var(--text-primary); }
  .chip input:checked + .chip__face .chip__dot { background: var(--text-primary); opacity: 1; }
  .chip input:focus-visible + .chip__face { outline: 2px solid var(--accent-primary); outline-offset: 3px; }

  .submit { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-32); padding-top: var(--sp-40); }
  .submit__note { display: flex; gap: var(--sp-12); align-items: flex-start; max-width: 470px; font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; letter-spacing: 0.02em; opacity: 0.72; }
  .submit__status { flex: none; width: 9px; height: 9px; margin-top: 3px; border-radius: 50%; background: var(--accent-primary); }
  .submit :global(.submit__btn) { flex: none; width: 188px; }
  .submit__msg { padding-top: var(--sp-16); font-family: var(--font-technical); font-size: var(--fs-caption); line-height: 1.4; color: var(--accent-bright); text-align: right; }
  .submit__msg:empty { display: none; }

  .inquiry__done { display: flex; flex-direction: column; gap: var(--sp-24); padding: 44px 0; border-top: 0.6px solid var(--border-subtle); }
  .inquiry__done[hidden] { display: none; }
  .inquiry__done:focus-visible { outline: 0; }
  .inquiry__done-mark { width: 24px; height: 24px; border-radius: 50%; background: var(--accent-primary); }
  .inquiry__done-text { font-weight: 500; font-size: var(--fs-block-title); line-height: 1.12; letter-spacing: -0.02em; }

  @media (max-width: 1199px) {
    .fsec { flex-direction: column; gap: var(--sp-24); }
    .fsec__head { flex: none; flex-direction: row; align-items: baseline; gap: var(--sp-16); }
  }
  @media (max-width: 767px) {
    .frow { flex-direction: column; gap: 28px; }
    .chip__face { min-height: 44px; }
    .submit { flex-direction: column; align-items: stretch; }
    .submit :global(.submit__btn) { width: 100%; }
    .submit__msg { text-align: left; }
  }
</style>

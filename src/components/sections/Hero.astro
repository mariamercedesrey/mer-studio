---
// Figma 149:5104 Hero — header band (soft) + video row with the "m" mark and the hero dot.
import SiteHeader from './SiteHeader.astro';
import Button from '../primitives/Button.astro';
import SignatureDot from '../primitives/SignatureDot.astro';

const industries = ['Ecommerce', 'Agribusiness', 'Fashion', 'Insurance', 'Finance', 'Foreign Trade', 'startups', 'Enterprise', 'Healthcare'];
const BOOK_A_CALL = 'mailto:hello@mer.studio?subject=Book%20a%20call';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__band">
    <SiteHeader />
    <div class="hero__intro">
      <div class="hero__copy">
        <p class="hero__lead">From the first decision to the last detail.</p>
        <h1 id="hero-title" class="hero__title">Strategy, design and build, end to end.</h1>
      </div>
      <Button href={BOOK_A_CALL}>book a call</Button>
    </div>
    <span class="hero__edge-dot" aria-hidden="true"></span>
  </div>

  <div class="hero__row">
    <div class="hero__media-col">
      <div class="hero__media">
        <video
          class="hero__video"
          src="/video/hero.mp4"
          poster="/video/hero.webp"
          width="1218"
          height="684"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          data-inview-video
        ></video>
      </div>
      <div class="hero__worked">
        <h2 class="hero__worked-title">wHERE WE'VE WORKED</h2>
        <ul role="list" class="hero__industries">
          {industries.map((name) => <li>[{name}]</li>)}
        </ul>
      </div>
    </div>

    <div class="hero__aside">
      <div class="hero__mark" aria-hidden="true">
        <span class="hero__m">m</span>
        <SignatureDot class="hero__dot" motion="hero-path" />
      </div>
      <p class="hero__summary">Strategy, design and code, handled end to end by one team. Twenty-five years across enterprise products and US startups, applied at any size — a brand, a website, an online store, a full platform.</p>
      <Button href="#contact">start a project</Button>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; }

  /* Header band — Figma 149:5105: soft ground, 28/48/100 padding, overlapped 65px by the row below. */
  .hero__band {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 116px;
    padding: 28px var(--page-gutter) 100px;
    margin-bottom: -65px;
    background: var(--surface-soft);
  }
  .hero__intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 23.75px;
    min-height: 502px;
  }
  .hero__copy { max-width: 880px; }
  .hero__lead {
    font-weight: 500;
    font-size: var(--fs-lead);
    line-height: 1.2;
  }
  .hero__title {
    font-weight: 400;
    font-size: clamp(48px, 6.667vw, 96px);
    line-height: 1.01;
    letter-spacing: -0.03em;
  }
  /* Figma 149:5138 — canvas-coloured circle bleeding off the left edge. */
  .hero__edge-dot {
    position: absolute;
    left: -18px;
    top: 548px;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: var(--surface-canvas);
  }

  /* Row — Figma 149:5139 / 2003:480 */
  .hero__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-48);
    padding: 0 var(--page-gutter) 70px 0;
  }
  .hero__media-col {
    flex: 0 0 auto;
    width: calc(929 / 1440 * 100%);
    display: flex;
    flex-direction: column;
    gap: var(--sp-24);
  }
  .hero__media { aspect-ratio: 929 / 507; overflow: hidden; background: var(--surface-canvas); }
  .hero__video { width: 100%; height: 100%; object-fit: cover; }
  .hero__worked {
    display: flex;
    flex-direction: column;
    gap: var(--sp-20);
    padding: 22px 0 0 var(--page-gutter);
  }
  .hero__worked-title {
    font-family: var(--font-technical);
    font-weight: 400;
    font-size: var(--fs-eyebrow);
    line-height: 1.5;
    letter-spacing: 0.02em;
  }
  .hero__industries {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-technical);
    font-size: var(--fs-caption);
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  .hero__aside {
    flex: 1 1 0;
    min-width: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-24);
    padding: 25px 0;
  }
  /* The "m" + dot, Figma 149:5143. Positions are expressed in em of the glyph so they scale together. */
  .hero__mark {
    display: inline-grid;
    font-size: clamp(160px, 19.82vw, 285.422px);
  }
  .hero__m {
    grid-area: 1 / 1;
    font-family: var(--font-brand);
    font-weight: 800;
    font-variation-settings: 'opsz' 14, 'wdth' 100;
    font-size: 1em;
    line-height: normal;
    letter-spacing: -0.07em;
    text-box: trim-both cap alphabetic;
  }
  .hero__mark :global(.hero__dot) {
    grid-area: 1 / 1;
    width: 0.161em;
    height: 0.161em;
    margin: 0.4921em 0 0 0.6667em;
  }
  .hero__summary {
    font-weight: 500;
    font-size: var(--fs-lead);
    line-height: 1.2;
  }
</style>

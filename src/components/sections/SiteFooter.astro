---
// The one footer, on every page: logo + channels (Figma 149:6087 Contact), the link list, and the copyright band (Figma 149:6099).
// Home links are in-page anchors on the home and "/#…" everywhere else (same rule as the header); direct entry lands via scripts/anchor-nav.ts.
// The band carries no links.
import { EMAIL, WHATSAPP } from '../../data/contact';
import { getCopy, localeOf, pagePath, pageOf, anchorHash } from '../../i18n';
const locale = localeOf(Astro.url);
const copy = getCopy(locale);
const { footer, site, a11y } = copy;
const homePath = pagePath('home', locale);
const home = pageOf(Astro.url.pathname)?.key === 'home';
const anchor = (h: string) => (home ? h : `${homePath}${h}`);
const links = [
  { label: footer.links.work, href: anchor(anchorHash('work', locale)) },
  { label: footer.links.services, href: anchor(anchorHash('services', locale)) },
  { label: footer.links.howItWorks, href: anchor(anchorHash('howItWorks', locale)) },
  { label: footer.links.ecommerce, href: pagePath('ecommerce', locale) },
  { label: footer.links.aiVisibility, href: pagePath('aiVisibility', locale) },
  { label: footer.links.about, href: anchor(anchorHash('about', locale)) },
  { label: footer.links.faq, href: pagePath('faq', locale) },
];
---
<footer class="site-footer" id="contact">
  <div class="site-footer__main">
    <div class="footer__top">
      <a class="footer__logo" href={homePath}>
        <img src="/logo-negative.svg" width="182" height="29" alt={site.logoAlt} />
      </a>
      <address class="footer__channels">
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a href={WHATSAPP.href} target="_blank" rel="noopener"><span class="visually-hidden">{a11y.whatsapp} </span>{WHATSAPP.label}<span class="visually-hidden"> {a11y.opensInNewTab}</span></a>
      </address>
    </div>
    <nav aria-label={footer.ariaLabel}>
      <ul role="list" class="footer__nav">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="site-footer__band">
    <p>{footer.copyright}</p>
    <p class="site-footer__where">{footer.workingFrom} <span class="site-footer__tag">{footer.country}</span></p>
  </div>
</footer>

<style>
  .site-footer__main {
    display: flex;
    flex-direction: column;
    gap: var(--sp-48);
    padding: var(--sp-48) var(--page-gutter);
    background: var(--surface-inverse); --focus-ring: var(--focus-ring-on-dark);
    color: var(--text-inverse);
    border-top: 0.6px solid var(--border-default);
  }
  .footer__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-24); flex-wrap: wrap; }
  /* Figma draws the wordmark at 65.3px type → the 182px logo scaled ×1.718. */
  .footer__logo { display: inline-flex; margin-top: 2px; }
  .footer__logo img { width: 312.7px; height: auto; }
  .footer__channels { display: flex; gap: 22px; font-style: normal; }
  /* Same size as the footer nav links (Mer, review round 10). */
  .footer__channels a {
    font-size: var(--fs-body);
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-precise);
  }
  .footer__channels a:hover, .footer__nav a:hover { color: var(--accent-primary); }
  .footer__nav { display: flex; flex-direction: column; gap: 14px; }
  @media (max-width: 767px) {
    .site-footer__main { gap: var(--sp-40); padding: var(--sp-48) var(--page-gutter); }
    .footer__top { flex-direction: column; gap: var(--sp-32); }
    .footer__logo img { width: 220px; }
    .footer__channels { flex-direction: column; gap: var(--sp-12); }
  }
  .footer__nav a {
    font-size: var(--fs-body);
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-precise);
  }

  .site-footer__band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-16);
    flex-wrap: wrap;
    padding: 14px var(--page-gutter);
    background: var(--surface-base);
    font-family: var(--font-technical);
    font-size: var(--fs-caption);
    line-height: 1.4;
    letter-spacing: 0.02em;
  }
  .site-footer__where { display: flex; align-items: center; gap: 10px; }
  @media (max-width: 767px) {
    .site-footer__band { flex-direction: column; align-items: flex-start; gap: var(--sp-8); padding-top: var(--sp-16); padding-bottom: var(--sp-16); }
  }
  .site-footer__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 94px;
    height: 23px;
    padding: var(--sp-4) 14px;
    border: 1px solid var(--text-primary);
  }
</style>

---
// Figma 149:6087 Contact — no form in V1 (D3): email + WhatsApp Business.
import { EMAIL, WHATSAPP } from '../../data/contact';
const links = [
  { label: 'Selected Works', href: '#work' },
  { label: 'Services', href: '#services' },
  { label: 'AI Visibility', href: '#ai-visibility' },
  { label: 'About Us', href: '#about' },
];
---
<section id="contact" class="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="visually-hidden">Contact</h2>
  <div class="contact__top">
    <a class="contact__logo" href="/" aria-label="MER Studio, home">
      <img src="/logo-negative.svg" width="182" height="29" alt="" />
    </a>
    <address class="contact__channels">
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a href={WHATSAPP.href} target="_blank" rel="noopener">WhatsApp {WHATSAPP.label}<span class="visually-hidden"> (opens in a new tab)</span></a>
    </address>
  </div>
  <nav aria-label="Footer">
    <ul role="list" class="contact__nav">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--sp-48);
    padding: var(--sp-48) var(--page-gutter);
    background: var(--surface-inverse);
    color: var(--text-inverse);
    border-top: 0.6px solid var(--border-default);
  }
  .contact__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-24); flex-wrap: wrap; }
  /* Figma draws the wordmark at 65.3px type → the 182px logo scaled ×1.718. */
  .contact__logo { display: inline-flex; margin-top: 2px; }
  .contact__logo img { width: 312.7px; height: auto; }
  .contact__channels { display: flex; gap: 22px; font-style: normal; }
  .contact__channels a {
    font-weight: 500;
    font-size: var(--fs-lead);
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-precise);
  }
  .contact__channels a:hover, .contact__nav a:hover { color: var(--accent-primary); }
  .contact__nav { display: flex; flex-direction: column; gap: 14px; }
  @media (max-width: 767px) {
    .contact { gap: var(--sp-40); padding: var(--sp-48) var(--page-gutter); }
    .contact__top { flex-direction: column; gap: var(--sp-32); }
    .contact__logo img { width: 220px; }
    .contact__channels { flex-direction: column; gap: var(--sp-12); }
    .contact__channels a { font-size: 22px; }
  }
  .contact__nav a {
    font-size: var(--fs-body);
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-precise);
  }
</style>

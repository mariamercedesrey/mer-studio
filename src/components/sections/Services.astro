---
// Figma Services in 3 stages — etapa 1 2248:714 (Venn), etapa 2 2248:3636 (drops separate, core appears), etapa 3 2248:6534
// (full diagram + list, "Project includes", "Added to any project"); active-row spec 2204:616.
// Desktop (≥1024, motion allowed): the section pins and advances by steps — 1 Venn · 2 drops + core + rings · 3 axis + pills ·
// 4 the diagram closes into the core and the content is revealed (scripts/services-stages.ts sets data-s2/s3/s4 on the section;
// the snap stops come from StepSnap). Mobile / tablet / reduced motion: no pin, stage 3 static (stacked on ≤1023) + the content.
// Without JS the markup is the static stage 3 (data-s2 data-s3 are its default state).
import SectionHeading from '../primitives/SectionHeading.astro';
import Button from '../primitives/Button.astro';
import StepSnap from '../primitives/StepSnap.astro';
import { offer } from '../../data/offer';

const included = [
  'Fixed scope and price',
  'Two rounds of revisions',
  'Responsive, mobile & desktop',
  'Files & accounts in your name',
];
const AI_HREF = '/ai-visibility/';
// Row titles = diagram pills, exactly (one list, one vocabulary).
const services = [
  { name: 'Branding', body: 'Identity, and the system to keep it consistent.' },
  { name: 'Websites', body: 'A landing, a full site, or an online store.' },
  { name: 'Digital Product', body: "An app or a platform that doesn't exist yet." },
  { name: 'AI Visibility', body: 'GEO / AEO — so people find you when they ask an AI, not just Google.', href: AI_HREF, offer: true },
];
// Add-ons = outer-ring chips, exactly. `more` = the expandable copy (Learn more / Show less); Maintenance has none.
const addons = [
  {
    id: 'design-system', title: 'Design System',
    body: 'Exported tokens, a documented component library, and a usage guide — so your team, or an AI agent, can keep building on it without breaking the system.',
    more: ['Design tokens (color, type, spacing) exported to code', 'Component library in Figma + code, with states and variants', 'Usage guide and do/don\'t rules', 'Handover session with your team'],
    for: 'products that will keep growing after launch.',
  },
  {
    id: 'ai-assistants', title: 'AI Assistants & Automation',
    body: 'AI assistants and automations that take repetitive work off your team — built into your site, store or product.',
    more: ['Assistants that answer customers with your own content', 'Automated flows: leads, orders, follow-ups, reports (n8n / API)', 'Connected to the tools you already use', 'Measured: what it saves, what it handles, what it escalates'],
    for: 'teams answering the same questions or doing the same steps every day.',
  },
  { id: 'maintenance', title: 'Maintenance', body: 'Optional, after handover. Changes, updates, backups and priority response.' },
];
// Diagram geometry (Figma 2248:6534): centre-relative offsets in px @1440, which are the design units of the 880 × 600
// drawing (--u scales them with the diagram's width). `i` = order of entrance.
const pills = [
  { label: 'AI Visibility', x: 59, y: -127, i: 0, link: AI_HREF },
  { label: 'Digital Product', x: 173, y: 50, i: 1 },
  { label: 'Websites', x: -118, y: 135, i: 2 },
  { label: 'Branding', x: -202, y: -51, i: 3 },
];
const chips = [
  { label: 'AI Assistants & Automation', x: 255, y: -202, i: 4 },
  { label: 'Maintenance', x: 148, y: 236, i: 5 },
  { label: 'Design System', x: -278, y: -135, i: 6 },
];
const diagramLabel = 'Services diagram: Brand and Product, connected by Strategy, Design and Build — one connected practice, 25+ years of experience.';
---
<section id="services" class="services" aria-labelledby="services-title" data-services data-s2 data-s3>
  <!-- Runs while parsing, before the section paints: the pinned layout must exist from the first frame (no layout shift). -->
  <script is:inline>
    (function () {
      try {
        var s = document.currentScript.parentElement;
        if (matchMedia('(min-width: 1024px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          s.setAttribute('data-pinned', '');
          s.removeAttribute('data-s2');
          s.removeAttribute('data-s3');
        }
      } catch (e) {}
    })();
  </script>

  <div class="services__track" data-svc-track>
    <StepSnap count={4} />
    <div class="services__pin">
      <SectionHeading eyebrow="services" id="services-title" title="Strategy, Design & Build, end to end" />

      <div class="services__stage">
        <div class="svc-dgwrap">
          <div class="svc-dg" role="group" aria-label={diagramLabel}>
            <svg class="svc-svg" viewBox="0 0 880 600" aria-hidden="true" focusable="false">
              <defs>
                <clipPath id="svc-clip-l"><circle cx="388" cy="300" r="110" /></clipPath>
                <mask id="svc-mask-tl" maskUnits="userSpaceOnUse" x="0" y="0" width="880" height="600">
                  <line class="svc-draw svc-draw--thread" x1="352" y1="300" x2="212" y2="300" pathLength="1" />
                </mask>
                <mask id="svc-mask-tr" maskUnits="userSpaceOnUse" x="0" y="0" width="880" height="600">
                  <line class="svc-draw svc-draw--thread" x1="528" y1="300" x2="668" y2="300" pathLength="1" />
                </mask>
                <mask id="svc-mask-outer" maskUnits="userSpaceOnUse" x="0" y="0" width="880" height="600">
                  <circle class="svc-draw" cx="440" cy="300" r="278.6" pathLength="1" transform="rotate(-90 440 300)" />
                </mask>
                <mask id="svc-mask-inner" maskUnits="userSpaceOnUse" x="0" y="0" width="880" height="600">
                  <circle class="svc-draw svc-draw--inner" cx="440" cy="300" r="173.5" pathLength="1" transform="rotate(-90 440 300)" />
                </mask>
              </defs>

              <g class="svc-contract">
                <circle class="svc-ring" cx="440" cy="300" r="278.6" mask="url(#svc-mask-outer)" />
                <circle class="svc-ring" cx="440" cy="300" r="173.5" mask="url(#svc-mask-inner)" />
              </g>

              <g class="svc-contract svc-drops">
                <rect class="svc-bar" x="176" y="210" width="528" height="180" />
                <circle class="svc-ball svc-ball--l" cx="440" cy="300" r="110" />
                <circle class="svc-ball svc-ball--r" cx="440" cy="300" r="110" />
              </g>
              <!-- Etapa 2 threads: ball → core, flared where they leave the ball (Figma 2248:3636) -->
              <g class="svc-contract">
                <path class="svc-thread svc-thread--l" mask="url(#svc-mask-tl)" d="M222 276.5C244 284 248 298 268 298H352V302H268C248 302 244 316 222 323.5Z" />
                <path class="svc-thread svc-thread--r" mask="url(#svc-mask-tr)" d="M658 276.5C636 284 632 298 612 298H528V302H612C632 302 636 316 658 323.5Z" />
              </g>
              <circle class="svc-lens" cx="492" cy="300" r="110" clip-path="url(#svc-clip-l)" />
              <circle class="svc-core" cx="440" cy="300" r="94" />

              <g class="svc-contract svc-axis">
                <line class="svc-axis-line" x1="48" y1="300" x2="338" y2="300" pathLength="1" />
                <line class="svc-axis-line" x1="832" y1="300" x2="542" y2="300" pathLength="1" />
                <circle class="svc-endpoint" cx="48" cy="300" r="5.1" />
                <circle class="svc-endpoint" cx="832" cy="300" r="5.1" />
              </g>
            </svg>

            <!-- Etapa 1 — Venn -->
            <span class="svc-t svc-v" aria-hidden="true" style="--x:-105;--y:2"><span class="svc-v__side">Brand</span></span>
            <span class="svc-t svc-v" aria-hidden="true" style="--x:105;--y:2"><span class="svc-v__side">Product</span></span>
            <span class="svc-t svc-v svc-v__lens" aria-hidden="true" style="--x:0;--y:9">
              <span class="svc-v__mer">MER</span>
              <span class="svc-v__years">25+ years of experience</span>
            </span>

            <!-- Etapas 2–3 — core, axis labels -->
            <span class="svc-t svc-core-text" style="--x:0;--y:0">
              <span class="svc-core-text__title">Strategy<br />Design<br />Build <i class="svc-core-text__dot" aria-hidden="true"></i></span>
              <span class="svc-core-text__desc">One connected<br />practice<br />MER Studio</span>
            </span>
            <span class="svc-t svc-axis-label svc-axis-label--brand" aria-hidden="true" style="--x:-379;--y:2">Brand</span>
            <span class="svc-t svc-axis-label svc-axis-label--product" aria-hidden="true" style="--x:361;--y:2">Product</span>

            <!-- Etapa 3 — area label, pills, outer chips -->
            <span class="svc-t svc-area" style="--x:0;--y:-227">25+ years of experience</span>
            {pills.map((p) => p.link ? (
              <a class:list={['svc-t', 'svc-pill', { 'svc-pill--offer': offer.active }]} href={p.link} style={`--x:${p.x};--y:${p.y};--i:${p.i}`}>
                <span class="svc-pill__label">{p.label}</span>
                {offer.active && <span class="svc-pill__tag" data-offer><span class="svc-pill__free">{offer.pill}</span> · <span class="svc-pill__more">{offer.more}</span></span>}
              </a>
            ) : (
              <span class="svc-t svc-pill" style={`--x:${p.x};--y:${p.y};--i:${p.i}`}>{p.label}</span>
            ))}
            {chips.map((c) => (
              <span class="svc-t svc-chip" style={`--x:${c.x};--y:${c.y};--i:${c.i}`}>{c.label}</span>
            ))}
          </div>
        </div>

        <!-- ≤1023 (and reduced motion is desktop-static): etapa 3 stacked — core, Brand + its pills, Product + its pills, add-ons -->
        <div class="svc-stack">
          <div class="svc-stack__core">
            <span class="svc-stack__core-title">Strategy<br />Design<br />Build <i class="svc-core-text__dot" aria-hidden="true"></i></span>
            <span class="svc-stack__core-desc">One connected<br />practice<br />MER Studio</span>
          </div>
          <p class="svc-stack__area">25+ years of experience</p>
          <ul role="list" class="svc-stack__pills svc-stack__pills--center">
            <li>
              <a class:list={['svc-pill', 'svc-pill--flow', { 'svc-pill--offer': offer.active }]} href={AI_HREF}>
                <span class="svc-pill__label">AI Visibility</span>
                {offer.active && <span class="svc-pill__tag" data-offer><span class="svc-pill__free">{offer.pill}</span> · <span class="svc-pill__more">{offer.more}</span></span>}
              </a>
            </li>
          </ul>
          <div class="svc-stack__side">
            <p class="svc-stack__label">Brand</p>
            <ul role="list" class="svc-stack__pills">{['Branding', 'Websites'].map((l) => <li class="svc-pill svc-pill--flow">{l}</li>)}</ul>
          </div>
          <div class="svc-stack__side">
            <p class="svc-stack__label">Product</p>
            <ul role="list" class="svc-stack__pills"><li class="svc-pill svc-pill--flow">Digital Product</li></ul>
          </div>
          <ul role="list" class="svc-stack__pills svc-stack__pills--chips">{chips.map((c) => <li class="svc-chip svc-chip--flow">{c.label}</li>)}</ul>
        </div>

        <p class="svc-caption">Set of services that complement each other and allow us to design, develop, implement, maintain, and extend a consistent experience</p>
        <div class="svc-next">
          <Button size="sm" icon="arrow-down" iconOnly aria-label="Next step" data-svc-next />
        </div>
      </div>
    </div>
  </div>

  <div class="services__body" id="services-content" data-svc-body>
    <ol role="list" class="services__list" data-services-list>
      {services.map((s, i) => (
        <li class="services__row svc-r" style={`--r:${i}`} data-services-row>
          <div class="services__row-main">
            <span class="services__slot" aria-hidden="true" data-services-slot></span>
            <h3 class="services__item-title">{s.href ? <a class="services__link" href={s.href}>{s.name}</a> : s.name}</h3>
            <p class="services__note">{s.body}</p>
            {s.offer && offer.active && <span class="offer-tag" data-offer><span class="offer-tag__free">{offer.tag}</span> · <span class="offer-tag__more">{offer.more}</span></span>}
            <span class="services__index">[{i + 1}]</span>
          </div>
        </li>
      ))}
    </ol>

    <div class="services__included svc-r svc-r--lift" style="--r:4" data-reveal="rise">
      <h3 class="services__included-title">EVERY PROJECT INCLUDES</h3>
      <ul role="list" class="services__included-list">
        {included.map((t) => <li><i class="services__bullet" aria-hidden="true"></i>{t}</li>)}
      </ul>
    </div>

    <div class="services__addons">
      <p class="services__addons-lead svc-r svc-r--lift" style="--r:5" data-reveal="rise">Added to any project — or contracted on their own.</p>
      <div class="services__addons-list">
        {addons.map((a, i) => (
          <article class="services__addon svc-r svc-r--lift" style={`--r:${6 + i}`} data-reveal="rise" data-addon>
            <h3 class="services__addon-title">{a.title}</h3>
            <p class="services__addon-body">{a.body}</p>
            {a.more && (
              <>
                <div class="services__addon-more" id={`addon-${a.id}`} data-addon-more>
                  <div class="services__addon-more-in">
                    <ul role="list" class="services__addon-list">{a.more.map((m) => <li>{m}</li>)}</ul>
                    <p class="services__addon-for"><b>For:</b> {a.for}</p>
                  </div>
                </div>
                <Button variant="outline-secondary" size="md" class="services__addon-btn" aria-expanded="false" aria-controls={`addon-${a.id}`} data-addon-toggle><span data-addon-label>Learn more</span></Button>
              </>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initServicesActive } from '../../scripts/services-active';
  import { initServicesStages } from '../../scripts/services-stages';
  initServicesActive();
  initServicesStages();

  // Add-ons: Learn more ⇄ Show less, in place.
  document.querySelectorAll<HTMLButtonElement>('[data-addon-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest<HTMLElement>('[data-addon]');
      if (!card) return;
      const open = !card.hasAttribute('data-open');
      card.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
      const label = btn.querySelector('[data-addon-label]');
      if (label) label.textContent = open ? 'Show less' : 'Learn more';
    });
  });
</script>

<style>
  .services {
    --svc-head: 99px; /* eyebrow 24 + gap 22 + title 53 (Figma Heading 2) */
    --svc-grey-ball: color-mix(in srgb, var(--color-neutral-900) 50%, var(--color-neutral-800)); /* Figma balls ≈ rgb(36) */
    --svc-grey-venn: color-mix(in srgb, var(--color-neutral-900) 25%, var(--color-neutral-800)); /* Figma Venn circles ≈ rgb(44) */
    --svc-grey-lens: color-mix(in srgb, var(--color-neutral-900) 78%, var(--color-neutral-800)); /* Figma Venn overlap ≈ rgb(27) */
    --svc-dur: 800ms;
    --svc-pill-fill: color-mix(in srgb, var(--color-neutral-500) 50%, var(--color-neutral-600)); /* Figma pills #727272 = midpoint of neutral-500/600 */
    --svc-exit: 800ms; /* stage 3 → 4: the diagram closes into the core; the content starts only after it (700–900 ms, ease-out) */
    padding: 3px var(--page-gutter) 100px;
    background: var(--surface-soft);
  }

  /* ── Frame: heading + stage. Static on ≤1023 / reduced motion; pinned (below) when data-pinned. ── */
  .services__pin { display: flex; flex-direction: column; gap: 45px; }
  .services__stage { display: flex; flex-direction: column; align-items: center; gap: var(--sp-24); }

  /* ── Diagram (≥1024). Everything is placed in design units of an 880 × 600 drawing; --u scales them. ── */
  .svc-dgwrap { container-type: inline-size; width: min(100%, 880px, calc(var(--dg-h, 600px) * 880 / 600)); } /* 880 px = Figma at 1440 (u = 1) */
  .svc-dg { --u: calc(100cqw / 880); position: relative; aspect-ratio: 880 / 600; }
  .svc-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .svc-t {
    position: absolute;
    left: calc(50% + var(--x) * var(--u));
    top: calc(50% + var(--y) * var(--u));
    transform: translate(-50%, -50%);
    white-space: nowrap;
    text-align: center;
  }

  /* Shapes. Transforms/opacity/stroke only (no filter: blur — §22); every state change is one transition on --ease-enter. */
  .svc-ring { fill: none; stroke: var(--color-neutral-400); stroke-width: 1; stroke-dasharray: 2 2; }
  .svc-draw { fill: none; stroke: #fff; stroke-width: 6; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1000ms var(--ease-enter) 250ms; }
  .svc-draw--inner { transition-delay: 450ms; }
  [data-s2] .svc-draw { stroke-dashoffset: 0; }

  .svc-bar { fill: var(--svc-grey-venn); transform-box: fill-box; transform-origin: center; transform: scaleX(0.197); transition: transform var(--svc-dur) var(--ease-enter), fill var(--svc-dur) var(--ease-enter); }
  [data-s2] .svc-bar { fill: var(--svc-grey-ball); transform: scaleX(1) scaleY(0.02); } /* the bridge between the drops: full at the start, a hair by the end */
  .svc-ball { fill: var(--svc-grey-venn); transform-box: fill-box; transform-origin: center; transition: transform var(--svc-dur) var(--ease-enter), fill var(--svc-dur) var(--ease-enter); }
  .svc-ball--l { transform: translateX(-52px); }
  .svc-ball--r { transform: translateX(52px); }
  [data-s2] .svc-ball { fill: var(--svc-grey-ball); }
  [data-s2] .svc-ball--l { transform: translateX(-264px) scale(0.5455); }
  [data-s2] .svc-ball--r { transform: translateX(264px) scale(0.5455); }
  /* Threads grow out of the core toward the balls once the drops have separated, and leave when the axis takes over. */
  .svc-thread { fill: var(--svc-grey-ball); opacity: 1; transition: opacity 300ms var(--ease-enter); }
  .svc-draw--thread { stroke-width: 60; transition: stroke-dashoffset 600ms var(--ease-enter) 450ms; }
  [data-s2] .svc-draw--thread { stroke-dashoffset: 0; }
  [data-s3] .svc-thread { opacity: 0; transition-duration: var(--dur-fast); }
  [data-s3] .svc-ball--l { transform: translateX(-392px) scale(0.0464); }
  [data-s3] .svc-ball--r { transform: translateX(392px) scale(0.0464); }
  .svc-drops { transition: opacity 350ms var(--ease-enter); }
  [data-s3] .svc-drops { opacity: 0; transition-delay: 450ms; }

  .svc-lens { fill: var(--svc-grey-lens); transition: opacity var(--dur-fast) var(--ease-enter); }
  [data-s2] .svc-lens { opacity: 0; transition: none; } /* gone at once: its cusps would stick out of the separating drops */
  .svc-core {
    fill: var(--surface-inverse);
    transform-box: fill-box; transform-origin: center; transform: scale(0.2); opacity: 0;
    transition: transform var(--svc-dur) var(--ease-enter) 250ms, opacity 400ms var(--ease-enter) 250ms;
  }
  [data-s2] .svc-core { transform: scale(1); opacity: 1; }

  .svc-axis-line { stroke: var(--text-primary); stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset var(--svc-dur) var(--ease-enter); }
  .svc-endpoint { fill: var(--text-primary); opacity: 0; transition: opacity 300ms var(--ease-enter); }
  [data-s3] .svc-axis-line { stroke-dashoffset: 0; transition-delay: 350ms; }
  [data-s3] .svc-endpoint { opacity: 1; transition-delay: 350ms; }

  /* Etapa 1 texts (fade out as the circles separate) */
  .svc-v { transition: opacity 250ms var(--ease-enter); color: var(--text-inverse); font-family: var(--font-display); }
  [data-s2] .svc-v { opacity: 0; }
  .svc-v__side { font-weight: 600; font-size: max(18px, calc(24 * var(--u))); line-height: 1; }
  .svc-v__lens { display: flex; flex-direction: column; align-items: center; gap: calc(6 * var(--u)); }
  .svc-v__mer { font-weight: 600; font-size: max(18px, calc(24 * var(--u))); line-height: 1; color: var(--accent-primary); }
  .svc-v__years { display: block; width: calc(100 * var(--u)); min-width: 96px; white-space: normal; font-weight: 400; font-size: max(13px, calc(14 * var(--u))); line-height: 1.35; letter-spacing: 0.04em; }

  /* Core text + axis labels (etapa 2 → 3) */
  .svc-core-text { display: flex; flex-direction: column; align-items: center; gap: calc(9 * var(--u)); max-width: calc(150 * var(--u)); color: var(--text-inverse); font-family: var(--font-display); opacity: 0; transition: opacity 400ms var(--ease-enter); }
  [data-s2] .svc-core-text { opacity: 1; transition-delay: 650ms; }
  .svc-core-text__title { display: block; text-align: left; color: var(--color-neutral-50); font-weight: 600; font-size: calc(18.8 * var(--u)); line-height: 1.1; letter-spacing: calc(-0.6 * var(--u)); }
  .svc-core-text__dot { display: inline-block; width: 0.83em; height: 0.83em; margin-left: 0.15em; border-radius: 50%; background: var(--accent-primary); vertical-align: -0.05em; }
  .svc-core-text__desc { display: block; text-align: center; color: var(--color-neutral-50); font-weight: 400; font-size: calc(13 * var(--u)); line-height: 1.1; }

  .svc-axis-label { font-family: var(--font-display); font-weight: 600; color: var(--text-secondary); font-size: calc(19 * var(--u)); line-height: 1; opacity: 0; transition: opacity 400ms var(--ease-enter), transform var(--svc-dur) var(--ease-enter), color var(--svc-dur) var(--ease-enter); }
  [data-s2] .svc-axis-label { opacity: 1; transition-delay: 500ms, 0s, 0s; }
  [data-s3] .svc-axis-label { color: var(--text-primary); font-size: calc(13.7 * var(--u)); transition-delay: 0s; }
  [data-s3] .svc-axis-label--brand { transform: translate(calc(-50% + 5 * var(--u)), calc(-50% - 15 * var(--u))); }
  [data-s3] .svc-axis-label--product { transform: translate(calc(-50% + 7 * var(--u)), calc(-50% - 15 * var(--u))); }

  /* Etapa 3 — area label, pills, chips */
  .svc-area { font-family: var(--font-display); font-weight: 700; font-size: calc(15.6 * var(--u)); letter-spacing: calc(3.1 * var(--u)); opacity: 0; transition: opacity 500ms var(--ease-enter); }
  [data-s3] .svc-area { opacity: 1; transition-delay: 500ms; }

  /* Figma: 38 px tall, full radius, Outfit SemiBold 13.7. Below 1440 the whole drawing scales (u); the floors keep type readable. */
  .svc-pill, .svc-chip {
    box-sizing: border-box;
    display: inline-flex; align-items: center;
    height: max(26px, calc(37.6 * var(--u)));
    padding: 0 calc(13.7 * var(--u));
    border-radius: 999px;
    font-family: var(--font-display); font-weight: 600; font-size: max(11px, calc(13.7 * var(--u))); line-height: 1;

---
// Figma 149:5756 Services; active-row spec 2204:616. scripts/services-active.ts drives the animated list.
import SectionHeading from '../primitives/SectionHeading.astro';
const included = [
  'Files and accounts handed over in your name',
  'Responsive design for mobile and desktop',
  'Two rounds of revisions',
  'Fixed scope and price before we start',
];
const services = [
  { name: 'Branding', body: 'Identity, and the system to keep it consistent.' },
  { name: 'Websites', body: 'A landing, a full site, or an online store.' },
  { name: 'Digital Product', body: "An app or a platform that doesn't exist yet." },
  { name: 'AI Visibility · GEO / AEO', body: 'So people find you when they ask an AI, not just Google.', href: '/ai-visibility/' },
];
const addons = [
  { title: 'Design System', body: 'Exported tokens, a documented component library, and a usage guide — so your team, or an AI agent, can keep building on it without breaking the system.' },
  { title: 'Maintenance', body: 'Optional, after handover. Changes, updates, backups and priority response.' },
];
---
<section id="services" class="services" aria-labelledby="services-title" data-services>
  <div class="services__top">
    <div class="services__intro">
      <SectionHeading eyebrow="services" id="services-title" title="Strategy, Design & Build, end to end" />
      <ol role="list" class="services__list" data-services-list>
        {services.map((s, i) => (
          <li class="services__row" data-services-row>
            <div class="services__row-main">
              <span class="services__slot" aria-hidden="true" data-services-slot></span>
              <h3 class="services__item-title">{s.href ? <a class="services__link" href={s.href}>{s.name}</a> : s.name}</h3>
              <p class="services__note">{s.body}</p>
              <span class="services__index">[{i + 1}]</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="services__card" data-reveal="rise">
      <h3 class="services__card-title">EVERY PROJECT INCLUDES</h3>
      <ul role="list" class="services__included">
        {included.map((t, i) => <li>[{i + 1}] —{t}</li>)}
      </ul>
    </div>
  </div>

  <div class="services__addons">
    <p class="services__addons-lead" data-reveal="rise">Added to any project — or contracted on their own.</p>
    <div class="services__addons-list">
      {addons.map((a) => (
        <article class="services__addon" data-reveal="rise">
          <h3 class="services__addon-title">{a.title}</h3>
          <p class="services__addon-body">{a.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { initServicesActive } from '../../scripts/services-active';
  initServicesActive();
</script>

<style>
  .services {
    display: flex;
    flex-direction: column;
    gap: 65px;
    padding: 3px var(--page-gutter) 100px;
    background: var(--surface-soft);
  }
  .services__top { display: flex; flex-direction: column; align-items: flex-end; gap: var(--sp-24); }
  .services__intro { display: flex; flex-direction: column; gap: 45px; width: min(822px, 100%); align-self: flex-start; }

  .services__list { display: flex; flex-direction: column; gap: 26px; }
  .services__list::after { content: ''; flex-shrink: 0; height: 1px; background: var(--fills-primary); }
  .services__row {
    display: flex;
    flex-direction: column;
    gap: var(--sp-20);
    min-height: 45px;
  }
  .services__row::before { content: ''; flex-shrink: 0; height: 1px; background: var(--fills-primary); }
  /* Figma 149:5766 — 24px start padding holds the 12px active dot (slot at x 6). */
  .services__row-main {
    position: relative;
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 0 2px 0 var(--sp-24);
  }
  .services__item-title { font-weight: 500; font-size: var(--fs-lead); line-height: 1.2; white-space: nowrap; }
  /* Linked row: the title link stretches over the whole row (no nested interactive content), ink on hover like a plain link. */
  .services__link { color: inherit; text-decoration: none; }
  .services__link::after { content: ''; position: absolute; inset: -10px 0; }
  .services__link:hover, .services__link:focus-visible { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .services__note { flex: 1 1 auto; font-weight: 500; font-size: var(--fs-meta); line-height: 1.2; letter-spacing: 0.02em; }
  .services__index { margin-left: auto; font-weight: 500; font-size: var(--fs-meta); line-height: 1.2; letter-spacing: 0.02em; }
  .services__slot { position: absolute; left: 6px; top: 8.5px; width: 12px; height: 12px; pointer-events: none; }

  /* Active row (Figma 2204:616): inactive rows sit at --opacity-service-inactive, only once JS is live. */
  .services[data-live] .services__row-main {
    opacity: var(--opacity-service-inactive);
    transition: opacity 250ms var(--ease-enter);
  }
  .services[data-live] .services__row[data-active] .services__row-main { opacity: 1; }

  /* The title's signature dot travels to the active row (transform only). */
  .services[data-live] :global(.section-heading__dot) {
    position: relative;
    z-index: 1;
    transform-origin: 0 0;
    transform: translate(var(--dot-x, 0), var(--dot-y, 0)) scale(var(--dot-s, 1));
    transition: transform var(--dot-dur, var(--dur-base)) var(--ease-enter);
    will-change: transform;
  }

  .services__card {
    width: min(754px, 100%);
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: var(--sp-24);
    border-radius: 16px;
    background: var(--surface-base);
  }
  .services__card-title { font-family: var(--font-technical); font-weight: 400; font-size: var(--fs-eyebrow); line-height: 24px; letter-spacing: 0.02em; }
  .services__included { display: flex; flex-direction: column; font-size: var(--fs-body); line-height: 1.5; }

  .services__addons { display: flex; justify-content: center; align-items: stretch; gap: 54px; }
  .services__addons-lead {
    flex: 0 0 332px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    font-size: var(--fs-block-title);
    line-height: 36px;
    text-align: right;
  }
  .services__addons-list { flex: 1 1 0; min-width: 0; display: flex; gap: 2px; }
  .services__addon {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5.8px;
    padding: 22px var(--sp-20);
    border-left: 1px dashed var(--divider-dashed);
  }
  .services__addon-title { font-weight: 500; font-size: var(--fs-lead); line-height: 1.2; }
  .services__addon-body { font-size: var(--fs-meta); line-height: 1.4; }

  /* Tablet: rows grow with their copy. */
  @media (max-width: 1199px) {
    .services { gap: var(--sp-48); padding-bottom: var(--sp-80); }
    .services__row-main { flex-wrap: wrap; row-gap: 4px; padding-right: var(--sp-40); }
    .services__note { flex-basis: 100%; }
    .services__index { position: absolute; right: 2px; top: 6px; }
    .services__list { gap: var(--sp-20); }
    .services__addons { flex-direction: column; gap: var(--sp-24); }
    .services__addons-lead { flex: none; justify-content: flex-start; text-align: left; }
    .services__addons-list { width: 100%; }
  }
  @media (max-width: 767px) {
    .services__item-title { font-size: 22px; white-space: normal; }
    .services__slot { top: 7px; }
    .services__addons-list { flex-direction: column; gap: var(--sp-16); }
    .services__addons-lead { font-size: var(--fs-lead-sm); line-height: 1.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .services[data-live] .services__row-main { opacity: 1; transition: none; }
    .services[data-live] :global(.section-heading__dot) { transform: none; transition: none; }
  }
</style>

---
// Page FAQ block (#faq): heading + accordion. Shared by /ai-visibility/ and /ecommerce/ (the visible items and the FAQPage JSON-LD come from the same array).
import SectionHeading from '../primitives/SectionHeading.astro';
import FaqList from '../primitives/FaqList.astro';
import type { FaqItem } from '../../data/faq';
interface Props { eyebrow: string; title: string; items: FaqItem[]; prefix: string }
const { eyebrow, title, items, prefix } = Astro.props;
---
<section class="page-faq" id="faq" aria-labelledby={`${prefix}-title`}>
  <SectionHeading eyebrow={eyebrow} title={title} id={`${prefix}-title`} dot={false} />
  <FaqList items={items} prefix={prefix} />
</section>

<style>
  .page-faq { display: flex; flex-direction: column; gap: var(--sp-32); padding: var(--sp-64) var(--page-gutter) var(--sp-96); }
</style>

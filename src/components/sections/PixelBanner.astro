---
// Figma 2118:51 — monochrome pixel mosaic (2045:2485) with the statement under it, between Selected Work and Services.
// The image is Figma's own render of 2045:2485 (crop already applied, monochrome) at 2×. The previous
// brand/assets/img/pixel-banner-mono.png was in colour (blue/yellow/red), not the greyscale mosaic in Figma.
// Ambient texture: scripts/pixel-rain.ts drops grid-sized squares over the whole banner (canvas, aria-hidden).
import { getImage } from 'astro:assets';
import banner from '../../assets/pixel-banner.png';
import WordReveal from '../primitives/WordReveal.astro';
import { copy } from '../../i18n';
const { banner: bannerCopy } = copy;
// Decorative texture: a CSS background (no <img>, so no alt to get wrong). 1× = 1436 px, 2× = 2872 px.
const [a1, a2, w1, w2] = await Promise.all(
  [[1436, 'avif'], [2872, 'avif'], [1436, 'webp'], [2872, 'webp']].map(([width, format]) => getImage({ src: banner, width: width as number, format: format as 'avif' | 'webp' })),
);
const art = `--art-avif-1:url(${a1.src});--art-avif-2:url(${a2.src});--art-webp-1:url(${w1.src});--art-webp-2:url(${w2.src})`;
---
<section class="pixel-banner" data-pixel-rain aria-label={bannerCopy.ariaLabel}>
  <canvas class="pixel-banner__rain" aria-hidden="true"></canvas>
  <div class="pixel-banner__art" aria-hidden="true" style={art}></div>
  <WordReveal class="pixel-banner__quote" data-rain-avoid text={bannerCopy.quote} />
</section>

<script>
  import { initPixelRain } from '../../scripts/pixel-rain';
  document.querySelectorAll<HTMLElement>('[data-pixel-rain]').forEach((el) => initPixelRain(el, 'banner'));
</script>

<style>
  .pixel-banner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    padding-bottom: 22px;
    overflow: hidden;
    overflow: clip; /* clip, not a scroll container: the quote's view() timeline must follow the page scroll, not this box */
    background: var(--surface-soft);
  }
  .pixel-banner__rain { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; pointer-events: none; } /* over the mosaic, under the statement */
  .pixel-banner__art {
    position: relative;
    width: calc(100% - 4px);
    aspect-ratio: 1436 / 255;
    overflow: hidden;
  }
  .pixel-banner__art {
    background: var(--art-webp-1) center / 100% 100% no-repeat; /* fallback without image-set() */
    background-image: image-set(var(--art-avif-1) type('image/avif') 1x, var(--art-avif-2) type('image/avif') 2x, var(--art-webp-1) type('image/webp') 1x, var(--art-webp-2) type('image/webp') 2x);
  }
  .pixel-banner__quote {
    position: relative;
    z-index: 2; /* above the canvas */
    width: min(854px, 100% - 2 * var(--page-gutter));
    font-family: var(--font-brand);
    font-variation-settings: 'opsz' 14, 'wdth' 100;
    font-size: clamp(22px, 2.222vw, 32px);
    line-height: normal;
    color: var(--text-primary);
  }
</style>

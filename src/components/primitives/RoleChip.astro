---
// Square role chip used in Selected Work captions.
---
<li class="role-chip"><slot /></li>

<style>
  .role-chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 9px;
    background: var(--surface-raised-dark);
    color: var(--text-inverse);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-caption);
    line-height: 1.2;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-precise), color var(--dur-fast) var(--ease-precise);
  }
  /* Decorative hover (chips are not links): accent/primary-dark ground, text-primary for AA (5.1:1; white is 3.6:1). */
  .role-chip:hover, .role-chip:focus-visible { background: var(--accent-primary-dark); color: var(--text-primary); }
  @media (prefers-reduced-motion: reduce) { .role-chip { transition: none; } }
</style>

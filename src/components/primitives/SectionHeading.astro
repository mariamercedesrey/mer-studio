---
// Section heading: mono eyebrow + Outfit 48/500 title + signature dot (Figma "Heading 2" pattern).
import SignatureDot from './SignatureDot.astro';
interface Props { eyebrow: string; id: string; tone?: 'light' | 'dark'; class?: string }
const { eyebrow, id, tone = 'light', class: className } = Astro.props;
---
<header class:list={['section-heading', `section-heading--${tone}`, className]}>
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <h2 id={id} class="section-heading__title"><slot />&#8288;<SignatureDot class="section-heading__dot" tone={tone === 'light' ? 'dark' : 'accent'} /></h2>
</header>

<style>
  .section-heading { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .section-heading--dark { color: var(--text-inverse); }
  .section-heading__eyebrow {
    font-family: var(--font-technical);
    font-size: var(--fs-eyebrow);
    line-height: 1.5;
    letter-spacing: 0.02em;
  }
  .section-heading__title {
    font-weight: 500;
    font-size: clamp(34px, 3.333vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .section-heading__title :global(.section-heading__dot) { margin-left: 0.25em; vertical-align: -0.02em; }
</style>

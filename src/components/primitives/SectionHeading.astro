---
// Section heading: mono eyebrow + Outfit 48/500 title + signature dot (Figma "Heading 2" pattern). The title decodes in (DecodeTitle); the dot stays out of it.
import SignatureDot from './SignatureDot.astro';
import DecodeTitle from './DecodeTitle.astro';
interface Props { eyebrow: string; title: string; id: string; tone?: 'light' | 'dark'; dotMotion?: string; class?: string; dot?: boolean }
const { eyebrow, title, id, tone = 'light', dotMotion = 'none', class: className, dot = true } = Astro.props;
---
<header class:list={['section-heading', `section-heading--${tone}`, className]}>
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <DecodeTitle as="h2" id={id} class="section-heading__title" text={title}>{dot && <SignatureDot class="section-heading__dot" tone={tone === 'light' ? 'dark' : 'accent'} motion={dotMotion} />}</DecodeTitle>
</header>

<style>
  .section-heading { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .section-heading--dark { color: var(--text-inverse); }
  .section-heading__eyebrow {
    font-family: var(--font-technical);
    font-size: var(--fs-eyebrow);
    line-height: 1.5;
    letter-spacing: 0.02em;
  }
  /* :global — the h2 is rendered by DecodeTitle, so it never carries this component's scope attribute. */
  .section-heading :global(.section-heading__title) {
    font-weight: 500;
    font-size: clamp(34px, 3.333vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .section-heading :global(.section-heading__title .section-heading__dot) { margin-left: 0.25em; vertical-align: -0.02em; }
</style>

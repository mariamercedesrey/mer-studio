---
// Figma 2007:229 Button — 8 styles × 2 states (Default / Disabled) × 3 sizes (Small 40 / Medium 48 / Large 56), pill,
// optional leading icon (Figma "Show icon" / "Icon": arrow-right, arrow-down; 16px, 20px on Large; currentColor).
// Hover / active / focus-visible are DS code-side rules (documented in the PR).
// One Primary per screen/section (CLAUDE.md §12b). Outline Primary + Negative are for dark grounds only.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline-primary' | 'outline-secondary' | 'negative' | 'ghost-negative' | 'ghost-primary';
  icon?: 'arrow-right' | 'arrow-down'; // leading icon (implies Show icon)
  iconOnly?: boolean; // round, no visible label: pass aria-label (a11y name) — Primary = yellow circle, dark arrow
  showIcon?: boolean; // Show icon without choosing one → arrow-right (Figma default)
  size?: 'sm' | 'md' | 'lg';
  onDark?: boolean; // Primary/Secondary/Ghost/Outline Secondary sitting on an ink ground: focus ring turns yellow
  disabled?: boolean; // always renders a <button disabled>: a link cannot be disabled
  type?: 'button' | 'submit';
  width?: number;   // Figma fixes some CTAs to a width (e.g. 183px)
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', icon, showIcon = false, iconOnly = false, size = 'md', onDark = false, disabled = false, type = 'button', width, class: className, ...rest } = Astro.props;
const style = width ? `width:${width}px` : undefined;
const iconName = icon ?? (showIcon ? 'arrow-right' : undefined);
const Tag = href && !disabled ? 'a' : 'button';
---
<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--on-dark': onDark, 'btn--icon-only': iconOnly }, className]}
  href={Tag === 'a' ? href : undefined}
  type={Tag === 'button' ? type : undefined}
  disabled={Tag === 'button' && disabled ? true : undefined}
  style={style}
  {...rest}
>{iconName && (
    <svg class="btn__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      {iconName === 'arrow-right'
        ? <path d="M3.33333 8H12.6667M8 3.33333L12.6667 8L8 12.6667" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
        : <path d="M8 3.33333V12.6667M3.33333 8L8 12.6667L12.6667 8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />}
    </svg>
  )}<slot /></Tag>

<style>
  .btn {
    --btn-bg: transparent;
    --btn-fg: var(--text-primary);
    --btn-ring: currentColor;
    --btn-focus: var(--focus-ring); /* accent/dark on light grounds, yellow on dark (inherited); dark-ground variants pin yellow */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-8);
    max-width: 100%;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow: inset 0 0 0 1px var(--btn-ring);
    font-family: var(--font-display);
    font-weight: 500;
    white-space: nowrap;
    text-transform: lowercase; /* every button label is lowercase (Mer) — one rule here, never per label */
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-precise),
      color var(--dur-fast) var(--ease-precise),
      box-shadow var(--dur-fast) var(--ease-precise),
      transform var(--dur-fast) var(--ease-precise);
  }

  /* Sizes — Figma: S 40 / 14px, M 48 / 16px, L 56 / 18px. */
  .btn--sm { min-height: var(--btn-h-sm); padding: 0 var(--sp-16); font-size: var(--fs-meta); line-height: 20px; }
  .btn--md { min-height: var(--btn-h-md); padding: 0 var(--sp-20); font-size: var(--fs-body); line-height: 20px; }
  .btn--lg { min-height: var(--btn-h-lg); padding: 0 var(--sp-24); font-size: var(--fs-body-lg); line-height: 24px; }

  /* Icon-only: a circle as wide as the size's height. */
  .btn--icon-only { padding: 0; width: var(--btn-h-md); }
  .btn--icon-only.btn--sm { width: var(--btn-h-sm); }
  .btn--icon-only.btn--lg { width: var(--btn-h-lg); }

  .btn__icon { flex: none; width: 16px; height: 16px; }
  .btn--lg .btn__icon { width: 20px; height: 20px; }

  /* Only the filled/outline variants draw the 1px ring; the rest keep it transparent so all six share one box. */
  .btn--primary, .btn--secondary, .btn--ghost, .btn--negative, .btn--ghost-negative, .btn--ghost-primary { --btn-ring: transparent; }

  .btn--primary { --btn-bg: var(--action-primary-background); --btn-fg: var(--action-primary-text); }
  .btn--secondary { --btn-bg: var(--action-secondary-background); --btn-fg: var(--action-secondary-text); }
  .btn--ghost { --btn-fg: var(--action-ghost-text); }
  .btn--outline-primary { --btn-fg: var(--action-primary-background); --btn-ring: var(--action-primary-background); --btn-focus: var(--accent-primary); }
  .btn--outline-secondary { --btn-fg: var(--action-secondary-background); --btn-ring: var(--action-secondary-background); }
  /* Ghost Negative (white) and Ghost Primary (yellow): dark grounds only. */
  .btn--ghost-negative { --btn-fg: var(--text-inverse); --btn-focus: var(--accent-primary); }
  .btn--ghost-primary { --btn-fg: var(--action-primary-background); --btn-focus: var(--accent-primary); }
  .btn--negative { --btn-bg: var(--action-negative-background); --btn-fg: var(--action-negative-text); --btn-focus: var(--accent-primary); }

  .btn--on-dark { --btn-focus: var(--accent-primary); }

  /* Hover — pointer devices only. Each style shifts one step within its own family. */
  @media (hover: hover) {
    .btn--primary:hover:not(:disabled) { --btn-bg: var(--accent-bright); }
    .btn--secondary:hover:not(:disabled) { --btn-bg: var(--surface-charcoal); }
    .btn--ghost:hover:not(:disabled) { --btn-bg: var(--fills-primary); }
    .btn--outline-primary:hover:not(:disabled) { --btn-bg: var(--action-primary-background); --btn-fg: var(--action-primary-text); }
    .btn--outline-secondary:hover:not(:disabled) { --btn-bg: var(--action-secondary-background); --btn-fg: var(--action-secondary-text); }
    .btn--negative:hover:not(:disabled) { --btn-bg: var(--surface-soft); }
    .btn--ghost-negative:hover:not(:disabled) { --btn-bg: var(--surface-overlay-ink); }
    .btn--ghost-primary:hover:not(:disabled) { --btn-bg: var(--surface-overlay-ink); --btn-fg: var(--accent-bright); }
  }

  .btn:active:not(:disabled) { transform: scale(0.97); }

  /* Focus — 2px ring, 3px offset. accent/dark on light grounds (yellow on white is ~1.7:1), yellow on dark grounds. */
  .btn:focus-visible { outline: 2px solid var(--btn-focus); outline-offset: 3px; }

  /* Disabled — Figma: grey fill + grey text; ghost has no fill; outlines keep a grey ring. */
  .btn:disabled {
    cursor: not-allowed;
    --btn-bg: var(--action-disabled-background);
    --btn-fg: var(--action-disabled-text);
  }
  .btn--ghost:disabled, .btn--ghost-negative:disabled, .btn--ghost-primary:disabled { --btn-bg: transparent; }
  .btn--outline-primary:disabled, .btn--outline-secondary:disabled { --btn-bg: transparent; --btn-ring: var(--action-disabled-text); }

  @media (prefers-reduced-motion: reduce) {
    .btn { transition: none; }
    .btn:active:not(:disabled) { transform: none; }
  }
</style>

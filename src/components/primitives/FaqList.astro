---
// FAQ accordion (Figma 2269:654). Shared by /faq/ and the FAQ on /ai-visibility/.
// Every answer is in the HTML (collapsed with CSS, never loaded by JS) so search and AI crawlers read them; without JS all answers stay open.
// Each question is <h3><button aria-expanded aria-controls>; the panel is a labelled region. Items open independently.
import { live, type FaqItem } from '../../data/faq';
interface Props { items: FaqItem[]; prefix: string }
const { items, prefix } = Astro.props;
const shown = live(items);
---
<div class="faq-list" data-faq>
  {shown.map((it, i) => (
    <div class="faq-item" data-offer={it.offer ? '' : undefined}>
      <h3 class="faq-item__q">
        <button type="button" id={`${prefix}-q${i + 1}`} class="faq-item__btn" aria-expanded="false" aria-controls={`${prefix}-a${i + 1}`}>
          <span class="faq-item__label">{it.q}</span>
          <span class="faq-item__toggle" aria-hidden="true"></span>
        </button>
      </h3>
      <div class="faq-item__panel" id={`${prefix}-a${i + 1}`} role="region" aria-labelledby={`${prefix}-q${i + 1}`}>
        <div class="faq-item__inner"><p class="faq-item__a">{it.a}</p></div>
      </div>
    </div>
  ))}
</div>

<script>
  // Toggle only: aria-expanded is the single state; CSS reads it. Enter/Space come from the native <button>.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((list) => {
    list.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('.faq-item__btn');
      if (btn) btn.setAttribute('aria-expanded', String(btn.getAttribute('aria-expanded') !== 'true'));
    });
  });
</script>

<style>
  .faq-list { border-top: 1px solid var(--border-default); }
  .faq-item { border-bottom: 1px solid var(--border-default); }
  .faq-item__q { margin: 0; font: inherit; }
  .faq-item__btn {
    display: flex; align-items: center; justify-content: space-between; gap: var(--sp-24);
    width: 100%; min-height: var(--hit-min); padding: var(--sp-24) 0; border: 0; background: none; text-align: left; cursor: pointer;
    font-weight: 400; font-size: var(--fs-lead); line-height: 1.3; color: var(--text-primary);
  }
  .faq-item__btn:focus-visible { outline-offset: -2px; }
  .faq-item__toggle { flex: none; font-weight: 300; font-size: 32px; line-height: 1; }
  .faq-item__toggle::before { content: '+'; }
  .faq-item__btn[aria-expanded='true'] .faq-item__toggle { color: var(--accent-dark); }
  .faq-item__btn[aria-expanded='true'] .faq-item__toggle::before { content: '−'; }

  .faq-item__a { max-width: 820px; margin: 0; padding: 0 0 var(--sp-24); font-family: var(--text-body-lg-family); font-weight: var(--text-body-lg-weight); font-size: var(--text-body-lg-size); line-height: var(--text-body-lg-line); color: var(--color-neutral-800); }

  /* Collapsed only when JS runs (no JS = every answer readable). Height opens with grid rows; visibility keeps closed answers out of the tab order. */
  :global(.js) .faq-item__panel { display: grid; grid-template-rows: 0fr; visibility: hidden; }
  :global(.js) .faq-item__inner { min-height: 0; overflow: hidden; }
  :global(.js) .faq-item__q:has(.faq-item__btn[aria-expanded='true']) + .faq-item__panel { grid-template-rows: 1fr; visibility: visible; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .faq-item__panel { transition: grid-template-rows var(--dur-base) var(--ease-enter), visibility 0s linear var(--dur-base); }
    :global(.js) .faq-item__q:has(.faq-item__btn[aria-expanded='true']) + .faq-item__panel { transition-delay: 0s; }
  }
  @media (max-width: 767px) {
    .faq-item__btn { font-size: var(--fs-lead-sm); }
  }
</style>

---
// Figma 2230:625 AI Visibility — page. Same building blocks as /start-a-project/ (intro, dark panel, steps, ink footer) + the home's FinalCTA.
// Hidden Figma layers (form fields, choices) are ignored. One Primary per section: "check my brand" (dark method panel); the final CTA is Outline Primary + Negative.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import OfferNotice from '../components/sections/OfferNotice.astro';
import MethodPanel from '../components/sections/MethodPanel.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import NextSteps from '../components/sections/NextSteps.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import { aiVisibilitySchema } from '../data/schema';
import { aiVisibilityFaq, faqSchema } from '../data/faq';
import { llmsSnippet } from '../data/llms-snippet';
import llms from '../../public/llms.txt?raw';
import { getCopy, localeOf, pagePath } from '../i18n';

const locale = localeOf(Astro.url);
const copy = getCopy(locale);
const faq = aiVisibilityFaq(locale);
const page = copy.aiVisibility;
const { buttons } = copy;

// Snippet card: generated at build from public/llms.txt (no manual sync): title, quote, "## Services" heading and its first list.
const snippet = llmsSnippet(llms);
---
<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  schema={[aiVisibilitySchema(locale), faqSchema(faq, `https://mer.studio${pagePath('aiVisibility', locale)}`, locale)]}
>
  <main id="main">
    <PageIntro
      id="aiv-title"
      eyebrow={page.intro.eyebrow}
      title={page.intro.title}
      note={page.intro.note}
    />
    <OfferNotice />
    <MethodPanel id="method-title" method={page.method} ctaHref={`${pagePath('startProject', locale)}?service=ai-visibility`} ctaLabel={buttons.checkMyBrand} />
    <NextSteps id="proof-title" eyebrow={page.proof.eyebrow} title={page.proof.title} steps={page.proof.steps}>
      <figure class="snippet" data-reveal="rise">
        <figcaption class="snippet__label">{page.proof.snippetLabel}</figcaption>
        <pre class="snippet__code"><code>{snippet}</code></pre>
      </figure>
    </NextSteps>
    <FaqSection eyebrow={page.faq.eyebrow} title={page.faq.title} items={faq} prefix="aiv-faq" />
    <FinalCTA eyebrow={page.cta.eyebrow} title={page.cta.title} />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  :global(body) { background: var(--surface-soft); }
  main { background: var(--surface-soft); }
  main :global(.intro__title) { text-wrap: wrap; } /* Figma 2230:651 breaks after "AI," (not balanced) */

  /* Real, selectable text — mono 14/1.6 on ink, Figma 2230:1376. */
  .snippet { margin: 0; display: flex; flex-direction: column; gap: var(--sp-12); padding: 28px var(--sp-32); border-radius: 16px; background: var(--surface-inverse); font-family: var(--font-technical); font-size: var(--fs-meta); line-height: 1.6; }
  .snippet__label { color: rgba(255, 255, 255, 0.5); }
  .snippet__code { margin: 0; color: rgba(255, 255, 255, 0.9); white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
  .snippet__code code { font: inherit; }

  @media (max-width: 767px) { .snippet { padding: var(--sp-24) var(--sp-20); } }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ClientMarquee from '../components/sections/ClientMarquee.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import PixelBanner from '../components/sections/PixelBanner.astro';
import Services from '../components/sections/Services.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import About from '../components/sections/About.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import HomeIntro from '../components/sections/HomeIntro.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import ProjectOverlay from '../components/work/ProjectOverlay.astro';
import { homeSchema } from '../data/schema';
import { localeOf } from '../i18n';
---
<BaseLayout schema={homeSchema(localeOf(Astro.url))}>
  <!-- Intro gate: first visit of the session, motion allowed. Runs before first paint; no attribute = no overlay (also without JS). -->
  <script is:inline slot="head">
    try {
      if (!location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('mer-intro')) { // a deep link (/#about) skips the intro: it lands on its section
        document.documentElement.setAttribute('data-intro', '');
        sessionStorage.setItem('mer-intro', '1');
      }
    } catch (e) {}
  </script>
  <HomeIntro />
  <main id="main">
    <Hero />
    <ClientMarquee />
    <SelectedWork />
    <PixelBanner />
    <Services />
    <HowItWorks />
    <About />
    <FinalCTA faqLink />
  </main>
  <SiteFooter />
  <ProjectOverlay />
</BaseLayout>

<script>
  import { initInviewVideos } from '../scripts/inview-video';
  initInviewVideos();
</script>
